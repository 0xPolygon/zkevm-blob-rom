; constants needed by executor C++
CONST %N = 2**19
CONST %MAX_CNT_STEPS_LIMIT = %N
CONST %MAX_CNT_ARITH_LIMIT = %N
CONST %MAX_CNT_BINARY_LIMIT = %N
CONST %MAX_CNT_MEM_ALIGN_LIMIT = %N
CONST %MAX_CNT_KECCAK_F_LIMIT = %N
CONST %MAX_CNT_PADDING_PG_LIMIT = %N
CONST %MAX_CNT_POSEIDON_G_LIMIT = %N

CONST %ZERO = 0x0
CONSTL %TWO_384 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffn ; 2^384
CONSTL %BLS12_381_P = 0x1a0111ea397fe69a4b1ba7b6434bacd764774b84f38512bf6730d2a0f6b0f6241eabfffeb153ffffb9feffffffffaaabn
CONSTL %BLS12_381_P_MINUS_ONE = %BLS12_381_P - 1n
CONSTL %BLS12_381_P_MINUS_TWO = %BLS12_381_P - 2n
CONSTL %BLS12_381_P_MUL_BY_TWO = 2*%BLS12_381_P

VAR GLOBAL lastHashKId
VAR GLOBAL lastHashPId

VAR GLOBAL initial_A
VAR GLOBAL initial_B
VAR GLOBAL initial_C
VAR GLOBAL initial_D
VAR GLOBAL initial_E
VAR GLOBAL initial_CTX
VAR GLOBAL initial_SP
VAR GLOBAL initial_PC
VAR GLOBAL initial_GAS
VAR GLOBAL initial_SR
VAR GLOBAL initial_RR
VAR GLOBAL initial_HASHPOS
VAR GLOBAL initial_RCX

start:

        STEP => A
        0 :ASSERT


        A           :MSTORE(initial_A)
        B           :MSTORE(initial_B)
        C           :MSTORE(initial_C)
        D           :MSTORE(initial_D)
        E           :MSTORE(initial_E)
        CTX         :MSTORE(initial_CTX)
        SP          :MSTORE(initial_SP)
        PC          :MSTORE(initial_PC)
        GAS         :MSTORE(initial_GAS)
        SR          :MSTORE(initial_SR)
        RR          :MSTORE(initial_RR)
        HASHPOS     :MSTORE(initial_HASHPOS)
        RCX         :MSTORE(initial_RCX)
        0 => A,B,C,D,E,CTX, SP, PC, GAS, SR, RR, HASHPOS, RCX

        -1          :MSTORE(lastHashKId)
        -1          :MSTORE(lastHashPId)

PRAGMA MODE_384_BITS

        /**
         * Addition(A,C) -> (C)
         **/
	; Test with ZERO
	%ZERO => A
	0x732945D14E4994437B973DF9F7D84EDDA2D04C8EA11FDDD618439FA7F698B6FA1DD2FB86A7228D1FC8F79B9E92CD7FAn => C
	:CALL(addFpBLS12381)
	C => A
	0x732945D14E4994437B973DF9F7D84EDDA2D04C8EA11FDDD618439FA7F698B6FA1DD2FB86A7228D1FC8F79B9E92CD7FAn	:ASSERT

	0x732945D14E4994437B973DF9F7D84EDDA2D04C8EA11FDDD618439FA7F698B6FA1DD2FB86A7228D1FC8F79B9E92CD7FAn => A
	%ZERO => C
	:CALL(addFpBLS12381)
	C => A
	0x732945D14E4994437B973DF9F7D84EDDA2D04C8EA11FDDD618439FA7F698B6FA1DD2FB86A7228D1FC8F79B9E92CD7FAn	:ASSERT

	; Test with BLS12_381_P
	%BLS12_381_P => A
	0x3AD76E8FC05A29B47F1291F32C38EBED0E886404F15CC07BFE80545C9DD8F8611F049EF506710B1EB9FEA27AB9A2F83n => C
	:CALL(addFpBLS12381)
	C => A
	0x3AD76E8FC05A29B47F1291F32C38EBED0E886404F15CC07BFE80545C9DD8F8611F049EF506710B1EB9FEA27AB9A2F83n	:ASSERT

	0x3AD76E8FC05A29B47F1291F32C38EBED0E886404F15CC07BFE80545C9DD8F8611F049EF506710B1EB9FEA27AB9A2F83n => A
	%BLS12_381_P => C
	:CALL(addFpBLS12381)
	C => A
	0x3AD76E8FC05A29B47F1291F32C38EBED0E886404F15CC07BFE80545C9DD8F8611F049EF506710B1EB9FEA27AB9A2F83n	:ASSERT

	; Test with TWO_384
	%TWO_384 => A
	0xB523E5235FE01C3A11BD68A34D8C4A9621E513835088010E637F4B264A4D38DA42B8C58DB81295D4900EF06940976CCn => C
	:CALL(addFpBLS12381)
	C => A
	0x7478B2BF6FEFFBCB207496B93E4043F75755E06B1D5C496DE4FBA68C1BB362471738C65EE392960050AEF06940CCC1Dn	:ASSERT

	0xB523E5235FE01C3A11BD68A34D8C4A9621E513835088010E637F4B264A4D38DA42B8C58DB81295D4900EF06940976CCn => A
	%TWO_384 => C
	:CALL(addFpBLS12381)
	C => A
	0x7478B2BF6FEFFBCB207496B93E4043F75755E06B1D5C496DE4FBA68C1BB362471738C65EE392960050AEF06940CCC1Dn	:ASSERT

	; Random tests
	; #1
	0x93CA1C0826CAB4F67EE793D6CE3D5D0FCA90364837386EBE2990CCF8E6B7C751A13012A61BBEFC88EB3850DEB90339Fn => A
	0xB2F4D67A3AF5F32E71F86B19DE9C81D92C6D8D61D93BD9C7BC7AEE081A4991384B619218BE868AC2979B90DB0EEC24Cn => C
	:CALL(addFpBLS12381)
	C => A
	0x146BEF28261C0A824F0DFFEF0ACD9DEE8F6FDC3AA10744885E60BBB0101015889EC91A4BEDA45874B82D3E1B9C7EF5EBn	:ASSERT

	0x233DB3AABBEC91E9B30A20F3B02F82A861204EE976F899AB49C9DF70851C729938BF0129130FEFC848B2850DEB8FDE4An => A
	0x25305F51DD2F45CD323B2E67E13574F4F73E245B1118D05BE2F8818178558F37A36219203D3C68ABE378B90DB0EE6CF7n => C
	:CALL(addFpBLS12381)
	C => A
	0x146BEF28261C0A824F0DFFEF0ACD9DEE8F6FDC3AA10744885E60BBB0101015889EC91A4BEDA45874B82D3E1B9C7EF5EBn	:ASSERT

	; #2
	0x10227CDD31A8F00C3351C24B25755154EC1F8CB7593277F52E53E4CAB197424EFB777A458B50C2F153C3B7B5D0D02A02n => A
	0xD6BAD192289C4C74C3F603C8D6B62A343D2CAF04DBBF29824FB20FAA18E90A8261C55B5164503759FCB71A26631E9AAn => C
	:CALL(addFpBLS12381)
	C => A
	0x38D180C1AB2CE3934757AD16F950720CB7B0C22B36957CDEC1E33245C74DCD302E7CFFBF041C6673990295837026901n	:ASSERT

	0x2A238EC76B28D6A67E6D6A0168C0FE2C5096D83C4CB78AB49584B76BA84838731A237A443CA4C2F10DC2B7B5D0CFD4ADn => A
	0x276CBF035C09AB61975B07F2D0B70F7AA84A1675414105578C2BF39B983F86CC44C855B3C799037559CA71A266319455n => C
	:CALL(addFpBLS12381)
	C => A
	0x38D180C1AB2CE3934757AD16F950720CB7B0C22B36957CDEC1E33245C74DCD302E7CFFBF041C6673990295837026901n	:ASSERT

        /**
         * Doubling(A) -> (B)
         **/


        ; 2] Subtraction
        2n => A
        3n => C
                                                                                        :CALL(subFpBLS12381)
        C => A
        %BLS12_381_P_MINUS_ONE                                                              :ASSERT

        ; 3] Squaring
        %BLS12_381_P_MINUS_TWO => A
                                                                                        :CALL(squareFpBLS12381)
        B => A
        4n                                                                              :ASSERT

        ; 4] Inversion
        0n => A
                                                                                        :CALL(invFpBLS12381)
        B => A
        0n                                                                              :ASSERT

        2n => A
                                                                                        :CALL(invFpBLS12381)
        B => A
        0xd0088f51cbff34d258dd3db21a5d66bb23ba5c279c2895fb39869507b587b120f55ffff58a9ffffdcff7fffffffd556n  :ASSERT

                                                                                        :JMP(end)

PRAGMA MODE_256_BITS

failAssert:
    1 => A
    2               :ASSERT

end:

        $ => A           :MLOAD(initial_A)
        $ => B           :MLOAD(initial_B)
        $ => C           :MLOAD(initial_C)
        $ => D           :MLOAD(initial_D)
        $ => E           :MLOAD(initial_E)
        $ => CTX         :MLOAD(initial_CTX)
        $ => SP          :MLOAD(initial_SP)
        $ => PC          :MLOAD(initial_PC)
        $ => GAS         :MLOAD(initial_GAS)
        $ => SR          :MLOAD(initial_SR)
        $ => RR          :MLOAD(initial_RR)
        $ => HASHPOS     :MLOAD(initial_HASHPOS)
        $ => RCX         :MLOAD(initial_RCX)

; label finalizeExecution needed by executor C++
finalizeExecution:
        ${beforeLast()}  : JMPN(finalizeExecution)

                         : JMP(start)
opINVALID:
; label checkAndSaveFrom needed by executor C++
checkAndSaveFrom:
                         :JMP(opINVALID)

INCLUDE "../src/bls12381/fpbls12381/addFpBLS12381.zkasm"
INCLUDE "../src/bls12381/fpbls12381/dblFpBLS12381.zkasm"
INCLUDE "../src/bls12381/fpbls12381/invFpBLS12381.zkasm"
INCLUDE "../src/bls12381/fpbls12381/mulFpBLS12381.zkasm"
INCLUDE "../src/bls12381/fpbls12381/negFpBLS12381.zkasm"
INCLUDE "../src/bls12381/fpbls12381/squareFpBLS12381.zkasm"
INCLUDE "../src/bls12381/fpbls12381/subFpBLS12381.zkasm"

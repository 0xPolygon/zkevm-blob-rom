	/**
         * sqrtFpBLS12381(C,A) -> (C,B)
         **/
	; Test with ZERO
	%ZERO => C
	0 => A
	:CALL(sqrtFpBLS12381)
	0 => A
	C 			:ASSERT
	B 			:ASSERT

	%ZERO => C
	1 => A
	:CALL(sqrtFpBLS12381)
	0 => A
	C 			:ASSERT
	B 			:ASSERT

	; Test with BLS12_381_P
	%BLS12_381_P => C
	0 => A
	:CALL(sqrtFpBLS12381)
	0 => A
	C 			:ASSERT
	B 			:ASSERT

	%BLS12_381_P => C
	1 => A
	:CALL(sqrtFpBLS12381)
	0 => A
	C 			:ASSERT
	B 			:ASSERT

	; Test with TWO_384
	%TWO_384 => C
	0 => A
	:CALL(sqrtFpBLS12381)
	1 => A
	C 			:ASSERT

	%TWO_384 => C
	1 => A
	:CALL(sqrtFpBLS12381)
	1 => A
	C 			:ASSERT


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_R)
;;
;; squareFrBLS12381:
;;             in: B ∈ [0, 2²⁵⁶-1]
;;             out: B = B² (mod BLS12_381_R) ∈ Fr
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; RESOURCES:
; -----------------------------
; [steps: 5, bin: 0, arith: 1]
; -----------------------------

squareFrBLS12381:
        ; B·B + 0 = op (mod BLS12_381_R)
        B => A
        0 => C
        %BLS12_381_R => D
        ${(A*A) % D} => B       :ARITH_MOD, RETURN
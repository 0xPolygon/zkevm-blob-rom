;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P)
;;
;; squareFpBLS12381:
;;             in: A ∈ [0, 2³⁸⁴ - 1]
;;             out: B = A² (mod BLS12381_P) ∈ Fp
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

; RESOURCES:
; -----------------------------
; [steps: r, bin: 0, arith: 1]
; -----------------------------

squareFpBLS12381:
        ; A·A + 0 = op (mod BLS12381_P)
        A => B
        0 => C
        %BLS12_381_P => D
        ${(A*A) % D} => B       :ARITH_384_MOD, RETURN
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P)
;;
;; mulFpBLS12381:
;;             in: A,B ∈ [0, 2³⁸⁴ - 1]
;;             out: C = A·B (mod BLS12_381_P) ∈ Fp
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

mulFpBLS12381:
        ; A·B + 0 = op (mod BLS12_381_P)
        0 => C
        %BLS12_381_P => D
        ${(A*B) % D} => C       :ARITH_384_MOD, RETURN
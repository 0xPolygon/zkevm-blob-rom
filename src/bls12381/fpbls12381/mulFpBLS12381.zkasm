;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P)
;;
;; mulFpBLS12381:
;;             in: A,B ∈ Fp
;;             out: C = A·B (mod BLS12_381_P) ∈ Fp
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; RESOURCES:
; -----------------------------
; [steps: 4, bin: 0, arith: 1]
; -----------------------------

mulFpBLS12381:
        ; A·B + 0 = op (mod BLS12_381_P)
        0 => C
        %BLS12_381_P => D
        ${(A*B) % D} => C       :ARITH_MOD, RETURN
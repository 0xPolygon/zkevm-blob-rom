;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P)
;;
;; dblFpBLS12381:
;;             in: A ∈ [0, 2³⁸⁴ - 1]
;;             out: B = A + A (mod BLS12381_P) ∈ Fp
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

dblFpBLS12381:
        ; A·1 + A = op (mod BLS12381_P)
        A => C
        1 => B
        %BLS12_381_P => D
        ${(A + A) % D} => B     :ARITH_384_MOD, RETURN
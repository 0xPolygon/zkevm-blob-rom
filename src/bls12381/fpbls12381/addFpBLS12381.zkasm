;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P)
;;
;; addFpBLS12381:
;;             in: A,C ∈ [0, 2³⁸⁴ - 1]
;;             out: C = A + C (mod BLS12381_P) ∈ Fp
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

addFpBLS12381:
        ; A·1 + C = op (mod BLS12381_P)
        1 => B
        %BLS12_381_P => D
        ${(A + C) % D} => C     :ARITH_384_MOD, RETURN
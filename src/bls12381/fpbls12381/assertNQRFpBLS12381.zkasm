;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  PRE: C is not alias free
;;
;; assertNQRFpBLS12381:
;;             in: C
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

; This function is using Euler's criterion pow(C, (p-1)/2) == -1 to determine that a given number is not a quadratic residue modulo p

; Efficiency of the exponentiation:
; (p-1)/2 = 0xd0088f51cbff34d258dd3db21a5d66bb23ba5c279c2895fb39869507b587b120f55ffff58a9ffffdcff7fffffffd555
;             (*) 1 x 1, 1 x 0,  1 x 1, 8 x 0,  1 x 1, 3 x 0, 1 x 1, 3 x 0, 4 x 1, 1 x 0,  1 x 1, 1 x 0,  1 x 1, 3 x 0,
;                 3 x 1, 2 x 0,  1 x 1, 1 x 0, 10 x 1, 2 x 0, 2 x 1, 1 x 0, 1 x 1, 2 x 0,  2 x 1, 1 x 0,  1 x 1, 2 x 0,
;                 1 x 1, 2 x 0,  1 x 1, 1 x 0,  2 x 1, 3 x 0, 2 x 1, 1 x 0, 3 x 1, 1 x 0,  1 x 1, 2 x 0,  4 x 1, 1 x 0,
;                 2 x 1, 1 x 0,  2 x 1, 2 x 0,  1 x 1, 4 x 0, 2 x 1, 1 x 0, 1 x 1, 2 x 0,  1 x 1, 1 x 0,  3 x 1, 1 x 0,
;                 1 x 1, 1 x 0,  2 x 1, 2 x 0,  2 x 1, 1 x 0, 1 x 1, 1 x 0, 3 x 1, 1 x 0,  2 x 1, 2 x 0,  1 x 1, 3 x 0,
;                 3 x 1, 1 x 0,  3 x 1, 1 x 0,  1 x 1, 2 x 0, 1 x 1, 1 x 0, 3 x 1, 4 x 0,  1 x 1, 2 x 0,  4 x 1, 2 x 0,
;                 3 x 1, 4 x 0,  1 x 1, 1 x 0,  1 x 1, 3 x 0, 1 x 1, 2 x 0, 1 x 1, 1 x 0,  1 x 1, 1 x 0,  6 x 1, 1 x 0,
;                 2 x 1, 2 x 0,  3 x 1, 2 x 0,  2 x 1, 4 x 0, 2 x 1, 1 x 0, 1 x 1, 2 x 0,  1 x 1, 1 x 0,  1 x 1, 1 x 0,
;                 1 x 1, 5 x 0,  4 x 1, 1 x 0,  2 x 1, 1 x 0, 1 x 1, 1 x 0, 2 x 1, 4 x 0,  4 x 1, 1 x 0,  2 x 1, 3 x 0,
;                 1 x 1, 2 x 0,  1 x 1, 5 x 0,  4 x 1, 1 x 0, 1 x 1, 1 x 0, 1 x 1, 1 x 0,  1 x 1, 1 x 0, 17 x 1, 1 x 0,
;                 1 x 1, 1 x 0,  2 x 1, 3 x 0,  1 x 1, 1 x 0, 1 x 1, 1 x 0, 1 x 1, 2 x 0, 19 x 1, 1 x 0,  3 x 1, 2 x 0,
;                 8 x 1, 1 x 0, 33 x 1, 1 x 0,  1 x 1, 1 x 0, 1 x 1, 1 x 0, 1 x 1, 1 x 0,  1 x 1, 1 x 0,  1 x 1, 1 x 0, 1 x 1, 1 x 0, 1 x 1
;             (*) 222 x SM, 1 x S, 22 x SM, 4 x S, 1 x SM, 1 x S, 3 x SM    (S=square M=multiplication)
;         BLOCK:  1         2      3        4      5       6      7
;             (*) 222 + initial initialization

VAR GLOBAL _base

assertNQRFpBLS12381:
        C => _base

        ; Set the modulus
        %BLS12_381_P => D

        ; === BLOCK1: 1/1 SM ===

        ; Square
        C => A,B
        0 => C
        ${(A*B) % D} => C       :ARITH_384_MOD

        ; Multiply
        _base => A
        C => B
        0 => C
        ${(A*B) % D} => C       :ARITH_384_MOD

        ; === BLOCK2: 1/1 S ===

        ; Square
        C => A,B

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12381_P)
;;
;; reduceFpBLS12381:
;;             in: A ∈ [0, 2²⁵⁶-1]
;;             out: A (mod BLS12381_P) ∈ Fp
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; RESOURCES:
; -----------------------------
; [steps: 5, bin: 0, arith: 1]
; -----------------------------

reduceFpBLS12381:
        ; A·1 + 0 = op (mod BLS12381_P)
        1 => B
        0 => C
        %BLS12381_P => D
        ${A % D} => A           :ARITH_MOD, RETURN
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  PRE: A is alias-free
;; POST: The result is in the range [0,BLS12_381_P)
;;
;; invFpBLS12381:
;;             in: A ∈ [0, 2³⁸⁴ - 1]
;;             out: B = A⁻¹ (mod BLS12381_P) ∈ Fp
;;
;; NOTE: On input 0, it returns 0
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

invFpBLS12381:
        ; Check if A = 0, and if so, return 0
        ${A == 0}               :JMP_EQ(1, _input_is_zero)

_zero_check:
        ; We must ensure that A != 0
        A => C                  :JMPNZ(invFpBLS12381_input_is_not_zero) ; chunk 0
        ROTL_C => C             :JMPNZ(invFpBLS12381_input_is_not_zero) ; chunk 1
        ROTL_C => C             :JMPNZ(invFpBLS12381_input_is_not_zero) ; chunk 2
        ROTL_C => C             :JMPNZ(invFpBLS12381_input_is_not_zero) ; chunk 3
        ROTL_C => C             :JMPNZ(invFpBLS12381_input_is_not_zero) ; chunk 4
        ROTL_C => C             :JMPNZ(invFpBLS12381_input_is_not_zero) ; chunk 5
        ROTL_C => C             :JMPNZ(invFpBLS12381_input_is_not_zero) ; chunk 6
        ROTL_C => C             :JMPZ(failAssert)          ; chunk 7

invFpBLS12381_input_is_not_zero:
        ; A·A⁻¹ + 0 = 1 (mod BLS12381_P)
        ${fpBLS12_381_inv(A)} => B
        0 => C
        %BLS12_381_P => D
        1                       :ARITH_384_MOD

        ; Check that the resulting element is lower than BLS12381_P
        ; 1·B + 0 = op (mod BLS12381_P)
        1 => A
        ${B % D} => C           :ARITH_384_MOD

        B - C => C              :JMPNZ(failAssert) ; chunk 0
        ROTL_C => C             :JMPNZ(failAssert) ; chunk 1
        ROTL_C => C             :JMPNZ(failAssert) ; chunk 2
        ROTL_C => C             :JMPNZ(failAssert) ; chunk 3
        ROTL_C => C             :JMPNZ(failAssert) ; chunk 4
        ROTL_C => C             :JMPNZ(failAssert) ; chunk 5
        ROTL_C => C             :JMPNZ(failAssert) ; chunk 6
        ROTL_C => C             :JMPNZ(failAssert) ; chunk 7
                                :RETURN

_input_is_zero:
        0 => B                  :ASSERT, RETURN
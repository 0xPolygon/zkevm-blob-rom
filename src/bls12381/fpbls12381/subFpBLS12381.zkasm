;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P)
;;
;; subFpBLS12381:
;;             in: A,C ∈ Fp
;;             out: C = A - C (mod BLS12381_P) ∈ Fp
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

subFpBLS12381:
        ; A·(-1) + C = op (mod BLS12_381_P)
        %BLS12_381_P_MINUS_ONE => B
        %BLS12_381_P => D
        ${(A*B + C) % D} => C     :ARITH_384_MOD, RETURN
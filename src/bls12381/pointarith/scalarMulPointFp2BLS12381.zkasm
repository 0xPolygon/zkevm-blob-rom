	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 21
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 22
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 23
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 24

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PRE: s ∈ Fr\{0}, P ∈ E(Fp)\{𝒪} of order larger than s and P.x1,P.x2,P.y1,P.y2 ∈ [0, 2³⁸⁴ - 1]
;; POST: The resulting coordinates are in the range [0,BLS12_381_P) because if falls back to addPoint and doublePoint
;;
;;
;; scalarMulPointFp2BLS12381:
;;             in: P = (P.x1 + P.x2·u, P.y1 + P.y2·u) ∈ E'(Fp2)
;;             out: [s]·P = (Q.x1 + Q.x2·u, Q.y1 + Q.y2·u) ∈ E'(Fp2)
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

; Since the curve is E/Fp: y² = x³ + 4, there is no issue in representing the point at infinity as (0, 0).

VAR GLOBAL scalarMulPointFp2BLS12381_s
VAR GLOBAL scalarMulPointFp2BLS12381_P_x1
VAR GLOBAL scalarMulPointFp2BLS12381_P_x2
VAR GLOBAL scalarMulPointFp2BLS12381_P_y1
VAR GLOBAL scalarMulPointFp2BLS12381_P_y2
VAR GLOBAL scalarMulPointFp2BLS12381_Q_x1
VAR GLOBAL scalarMulPointFp2BLS12381_Q_x2
VAR GLOBAL scalarMulPointFp2BLS12381_Q_y1
VAR GLOBAL scalarMulPointFp2BLS12381_Q_y2

VAR GLOBAL _accumulator

VAR GLOBAL _RR

scalarMulPointFp2BLS12381:
        RR => _RR

        ; receive the length of the binary representation of s minus 1 (i.e., the index)
        ; It should be that: 0 <= len(s) - 1 <= 254
        $BYTE{lenBinDecomp(mem.scalarMulPointFp2BLS12381_s) - 1} => RCX,E               :JMP_EQ(255, failAssert)

        ; Initialize the accumulator
        0 => HASHPOS,_accumulator

        ; Initialize Q = P
        scalarMulPointFp2BLS12381_P_x1 => A
        scalarMulPointFp2BLS12381_P_x2 => B
        A => scalarMulPointFp2BLS12381_Q_x1
        B => scalarMulPointFp2BLS12381_Q_x2
        scalarMulPointFp2BLS12381_P_y1 => A
        scalarMulPointFp2BLS12381_P_y2 => B
        A => scalarMulPointFp2BLS12381_Q_y1
        B => scalarMulPointFp2BLS12381_Q_y2

        ; It cannot be that the MSB of s is 0 (recall this function does not accept s = 0)
        $0{(mem.scalarMulPointFp2BLS12381_s >> RCX) & 0x1}                              :JMP_NE(1, failAssert, @_update_first_bit + E)

_double:
        ; We always double
        scalarMulPointFp2BLS12381_Q_x1 => A
        scalarMulPointFp2BLS12381_Q_x2 => B
        A => doublePointFp2BLS12381_P_x1
        B => doublePointFp2BLS12381_P_x2
        scalarMulPointFp2BLS12381_Q_y1 => A
        scalarMulPointFp2BLS12381_Q_y2 => B
        A => doublePointFp2BLS12381_P_y1
        B => doublePointFp2BLS12381_P_y2                        :CALL(doublePointFp2BLS12381)
        ; Q = Q + Q

        doublePointFp2BLS12381_Q_x1 => A
        doublePointFp2BLS12381_Q_x2 => B
        A => scalarMulPointFp2BLS12381_Q_x1
        B => scalarMulPointFp2BLS12381_Q_x2
        doublePointFp2BLS12381_Q_y1 => A
        doublePointFp2BLS12381_Q_y2 => B
        A => scalarMulPointFp2BLS12381_Q_y1
        B => scalarMulPointFp2BLS12381_Q_y2

        ; If bit = 1, then add, otherwise, repeat
        RCX => E
        $0{(mem.scalarMulPointFp2BLS12381_s >> RCX) & 0x1}      :JMPZ(@_update_bit_is_0 + E, @_update_bit_is_1 + E)

_add:
        ; We add
        scalarMulPointFp2BLS12381_Q_x1 => A
        scalarMulPointFp2BLS12381_Q_x2 => B
        A => addPointFp2BLS12381_P1_x1
        B => addPointFp2BLS12381_P1_x2
        scalarMulPointFp2BLS12381_Q_y1 => A
        scalarMulPointFp2BLS12381_Q_y2 => B
        A => addPointFp2BLS12381_P1_y1
        B => addPointFp2BLS12381_P1_y2
        scalarMulPointFp2BLS12381_P_x1 => A
        scalarMulPointFp2BLS12381_P_x2 => B
        A => addPointFp2BLS12381_P2_x1
        B => addPointFp2BLS12381_P2_x2
        scalarMulPointFp2BLS12381_P_y1 => A
        scalarMulPointFp2BLS12381_P_y2 => B
        A => addPointFp2BLS12381_P2_y1
        B => addPointFp2BLS12381_P2_y2                          :CALL(addPointFp2BLS12381)
        ; Q = Q + P

        addPointFp2BLS12381_P3_x1 => A
        addPointFp2BLS12381_P3_x2 => B
        A => scalarMulPointFp2BLS12381_Q_x1
        B => scalarMulPointFp2BLS12381_Q_x2
        addPointFp2BLS12381_P3_y1 => A
        addPointFp2BLS12381_P3_y2 => B
        A => scalarMulPointFp2BLS12381_Q_y1
        B => scalarMulPointFp2BLS12381_Q_y2

        RCX - 1 => RCX		                                :JMPN(_check, _double)

_check:
        scalarMulPointFp2BLS12381_s => A
        A                                                       :MLOAD(_accumulator)

_end:
        _RR => RR                                               :RETURN

; ====================
; Tables
; ====================
_save_s_short:
        ; There is no need to load C since it has been done in the table
        ; _accumulator => C
        ROTL_C + HASHPOS => _accumulator

        0 => HASHPOS

_update_index:
        RCX - 1 => RCX		:JMPN(_check, _double)

_save_s:
        _accumulator => C
        ROTL_C + HASHPOS => _accumulator

        0 => HASHPOS 	                        :JMP(_add)
; Sage code
; ----------------------------------------
; binLen = 254
; clock = 48
; for i in range(binLen):
;     latch = i % clock
;     power = 2**latch
;     if (latch == 0):
;         print("\t_accumulator => C\t:JMP(_save_s_short)\t; RCX = {}".format(i))
;     else:
;         print("\tRCX - 1 => RCX\t\t:JMPN(_check, _double)\t; RCX = {}".format(i))
; ----------------------------------------
_update_bit_is_0:
	_accumulator => C	:JMP(_save_s_short)	; RCX = 0
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 1
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 2
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 3
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 4
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 5
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 6
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 7
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 8
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 9
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 10
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 11
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 12
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 13
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 14
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 15
	RCX - 1 => RCX		:JMPN(_check, _double)	; RCX = 16

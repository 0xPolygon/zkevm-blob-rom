;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; PRE: P is in E'(Fp2)\{𝒪} with P.x1,P.x2,P.y1,P.y2 ∈ [0, 2³⁸⁴ - 1]
;; POST: The resulting coordinates are in the range [0,BLS12_381_P) because if falls back to FP2 arithmetic
;;
;; doublePointFp2BLS12381:
;;             in: P = (P.x1 + P.x2·u, P.y1 + P.y2·u) ∈ E'(Fp2)
;;             out: [2]·P = (Q.x1 + Q.x2·u, Q.y1 + Q.y2·u) ∈ E'(Fp2)
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

; Points of order 2 are of the form (x, 0), but notice that on E'/Fp2: y'² = x'³ + 4·(1+u) there
; not exist such points, so we can assume that P.y ≠ 0 and the output will never be the point at infinity

VAR GLOBAL doublePointFp2BLS12381_P_x1
VAR GLOBAL doublePointFp2BLS12381_P_x2
VAR GLOBAL doublePointFp2BLS12381_P_y1
VAR GLOBAL doublePointFp2BLS12381_P_y2
VAR GLOBAL doublePointFp2BLS12381_Q_x1
VAR GLOBAL doublePointFp2BLS12381_Q_x2
VAR GLOBAL doublePointFp2BLS12381_Q_y1
VAR GLOBAL doublePointFp2BLS12381_Q_y2

VAR GLOBAL _lambda_x
VAR GLOBAL _lambda_y

VAR GLOBAL _RR

doublePointFp2BLS12381:
        RR => _RR

        doublePointFp2BLS12381_P_y1 => A
        doublePointFp2BLS12381_P_y2 => B
        doublePointFp2BLS12381_P_y1 => C
        doublePointFp2BLS12381_P_y2 => D        :CALL(addFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        ; E + C·u = 2y

        E => A
        C => B                                  :CALL(invFp2BLS12381) ; in: [A,B] out: [C,D]
        ; C + D·u = 1 / 2y

        3n => A                                 :CALL(scalarMulFp2BLS12381) ; in: [A,C,D] out: [E,C]
        ; E + C·u = 3/2y

        doublePointFp2BLS12381_P_x1 => A
        doublePointFp2BLS12381_P_x2 => B
        C => D
        E => C                                  :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        ; E + C·u = 3x/2y

        doublePointFp2BLS12381_P_x1 => A
        doublePointFp2BLS12381_P_x2 => B
        C => D
        E => C                                  :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        ; E + C·u = lambda = 3x²/2y

        E => _lambda_x
        C => _lambda_y
        ; E + C·u = lambda

        E => A
        C => B                                  :CALL(squareFp2BLS12381) ; in: [A,B] out: [E,C]
        ; E + C·u = lambda²

        E => A
        C => B
        doublePointFp2BLS12381_P_x1 => C
        doublePointFp2BLS12381_P_x2 => D        :CALL(subFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        ; E + C·u = lambda² - P.x

        E => A
        C => B
        doublePointFp2BLS12381_P_x1 => C
        doublePointFp2BLS12381_P_x2 => D        :CALL(subFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        ; E + C·u = lambda² - P.x - P.x

        E => doublePointFp2BLS12381_Q_x1
        C => doublePointFp2BLS12381_Q_x2
        ; Q.x = lambda² - P.x - P.x

        doublePointFp2BLS12381_P_x1 => A
        doublePointFp2BLS12381_P_x2 => B
        C => D
        E => C                                  :CALL(subFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        ; E + C·u = P.x - Q.x

        _lambda_x => A
        _lambda_y => B
        C => D
        E => C                                  :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        ; E + C·u = lambda·(P.x - Q.x)

        E => A
        C => B
        doublePointFp2BLS12381_P_y1 => C
        doublePointFp2BLS12381_P_y2 => D        :CALL(subFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        ; E + C·u = lambda·(P.x - Q.x) - P.y

        E => doublePointFp2BLS12381_Q_y1
        C => doublePointFp2BLS12381_Q_y2

        _RR => RR                               :RETURN
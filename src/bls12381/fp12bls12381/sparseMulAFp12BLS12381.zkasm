;; POST: The result is in the range [0,BLS12381_P) because if falls back to FP6 arithmetic
;;
;; sparseMulAFp12BLS12381:
;;             in: (a1 + a2·w),(b1 + b2·w) ∈ Fp12, where ai ∈ Fp6, b1 = b12·v and b2 = b22·v + b23·v², with b12,b22,b23 ∈ Fp2
;;             out: (a1 + a2·w)·(b1 + b2·w) = (c1 + c2·w) ∈ Fp12, where:
;;                  - c1 = a1·b1 + a2·b2·v
;;                  - c2 = (a1+a2)·[(b12+b22)·v + b23·v²] - a1·b1 - a2·b2
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

VAR GLOBAL sparseMulAFp12BLS12381_a11_x
VAR GLOBAL sparseMulAFp12BLS12381_a11_y

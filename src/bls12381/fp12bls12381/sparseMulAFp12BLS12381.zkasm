        B => sparseMulBFp6BLS12381_a2_y
        addFp6BLS12381_c3_x => A
        addFp6BLS12381_c3_y => B
        A => sparseMulBFp6BLS12381_a3_x
        B => sparseMulBFp6BLS12381_a3_y
        _aux2_x => A
        _aux2_y => B
        A => sparseMulBFp6BLS12381_b2_x
        B => sparseMulBFp6BLS12381_b2_y
        sparseMulAFp12BLS12381_b23_x => A
        sparseMulAFp12BLS12381_b23_y => B
        A => sparseMulBFp6BLS12381_b3_x
        B => sparseMulBFp6BLS12381_b3_y         :CALL(sparseMulBFp6BLS12381)
        sparseMulBFp6BLS12381_c1_x => A
        sparseMulBFp6BLS12381_c1_y => B

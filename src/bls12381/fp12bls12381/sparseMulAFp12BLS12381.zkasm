VAR GLOBAL _aux2_y

VAR GLOBAL _RR

; RESOURCES:
; -----------------------------
; [steps: 664, bin: 0, arith: 51]
; -----------------------------

sparseMulAFp12BLS12381:
        RR => _RR

        ; 1] a1·b1, a2·b2
        sparseMulAFp12BLS12381_a11_x => A
        sparseMulAFp12BLS12381_a11_y => B
        A => sparseMulAFp6BLS12381_a1_x
        B => sparseMulAFp6BLS12381_a1_y
        sparseMulAFp12BLS12381_a12_x => A
        sparseMulAFp12BLS12381_a12_y => B
        A => sparseMulAFp6BLS12381_a2_x
        B => sparseMulAFp6BLS12381_a2_y
        sparseMulAFp12BLS12381_a13_x => A
        sparseMulAFp12BLS12381_a13_y => B
        A => sparseMulAFp6BLS12381_a3_x
        B => sparseMulAFp6BLS12381_a3_y
        sparseMulAFp12BLS12381_b12_x => A
        sparseMulAFp12BLS12381_b12_y => B
        A => sparseMulAFp6BLS12381_b2_x
        B => sparseMulAFp6BLS12381_b2_y         :CALL(sparseMulAFp6BLS12381)
        sparseMulAFp6BLS12381_c1_x => A
        sparseMulAFp6BLS12381_c1_y => B
        A => _a1b1mul1_x
        B => _a1b1mul1_y
        sparseMulAFp6BLS12381_c2_x => A
        sparseMulAFp6BLS12381_c2_y => B

        _a2b2mul3_y => B
        A => sparseMulAFp6BLS12381_a3_x
        B => sparseMulAFp6BLS12381_a3_y
        1 => sparseMulAFp6BLS12381_b2_x
        0 => sparseMulAFp6BLS12381_b2_y         :CALL(sparseMulAFp6BLS12381)
        sparseMulAFp6BLS12381_c1_x => A
        sparseMulAFp6BLS12381_c1_y => B
        A => addFp6BLS12381_a1_x
        B => addFp6BLS12381_a1_y
        sparseMulAFp6BLS12381_c2_x => A
        sparseMulAFp6BLS12381_c2_y => B
        A => addFp6BLS12381_a2_x
        B => addFp6BLS12381_a2_y
        sparseMulAFp6BLS12381_c3_x => A
        sparseMulAFp6BLS12381_c3_y => B
        A => addFp6BLS12381_a3_x
        B => addFp6BLS12381_a3_y
        _a1b1mul1_x => A
        _a1b1mul1_y => B
        A => addFp6BLS12381_b1_x
        B => addFp6BLS12381_b1_y
        _a1b1mul2_x => A
        _a1b1mul2_y => B
        A => addFp6BLS12381_b2_x
        B => addFp6BLS12381_b2_y
        _a1b1mul3_x => A
        _a1b1mul3_y => B
        A => addFp6BLS12381_b3_x
        B => addFp6BLS12381_b3_y                :CALL(addFp6BLS12381)
        addFp6BLS12381_c1_x => A
        addFp6BLS12381_c1_y => B
        A => sparseMulAFp12BLS12381_c11_x
        B => sparseMulAFp12BLS12381_c11_y
        addFp6BLS12381_c2_x => A
        addFp6BLS12381_c2_y => B
        A => sparseMulAFp12BLS12381_c12_x
        B => sparseMulAFp12BLS12381_c12_y
        addFp6BLS12381_c3_x => A
        addFp6BLS12381_c3_y => B
        A => sparseMulAFp12BLS12381_c13_x
        B => sparseMulAFp12BLS12381_c13_y

        ; 3] aux = (b12+b22)·v + b23·v²
        sparseMulAFp12BLS12381_b12_x => A
        sparseMulAFp12BLS12381_b12_y => B
        sparseMulAFp12BLS12381_b22_x => C
        sparseMulAFp12BLS12381_b22_y => D       :CALL(addFp2BLS12381)
        E => _aux2_x
        C => _aux2_y

        ; 4] c2 = (a1+a2)·aux - a1·b1 - a2·b2
        sparseMulAFp12BLS12381_a11_x => A
        sparseMulAFp12BLS12381_a11_y => B
        A => addFp6BLS12381_a1_x
        B => addFp6BLS12381_a1_y

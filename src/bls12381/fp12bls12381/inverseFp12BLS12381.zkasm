;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P) because if falls back to FP6 arithmetic
;;
;; inverseFp12BLS12381:
;;             in: (a1 + a2·w) ∈ Fp12, where ai ∈ Fp6
;;             out: (a1 + a2·w)⁻¹ = (c1 + c2·w) ∈ Fp12, where:
;;                  - c1 = a1·(a1² - a2²·v)⁻¹
;;                  - c2 = -a2·(a1² - a2²·v)⁻¹
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

VAR GLOBAL inverseFp12BLS12381_a11_x
VAR GLOBAL inverseFp12BLS12381_a11_y
VAR GLOBAL inverseFp12BLS12381_a12_x
VAR GLOBAL inverseFp12BLS12381_a12_y
VAR GLOBAL inverseFp12BLS12381_a13_x
VAR GLOBAL inverseFp12BLS12381_a13_y
VAR GLOBAL inverseFp12BLS12381_a21_x
VAR GLOBAL inverseFp12BLS12381_a21_y
VAR GLOBAL inverseFp12BLS12381_a22_x
VAR GLOBAL inverseFp12BLS12381_a22_y
VAR GLOBAL inverseFp12BLS12381_a23_x
VAR GLOBAL inverseFp12BLS12381_a23_y
VAR GLOBAL inverseFp12BLS12381_c11_x
VAR GLOBAL inverseFp12BLS12381_c11_y
VAR GLOBAL inverseFp12BLS12381_c12_x
VAR GLOBAL inverseFp12BLS12381_c12_y
VAR GLOBAL inverseFp12BLS12381_c13_x
VAR GLOBAL inverseFp12BLS12381_c13_y
VAR GLOBAL inverseFp12BLS12381_c21_x
VAR GLOBAL inverseFp12BLS12381_c21_y
VAR GLOBAL inverseFp12BLS12381_c22_x
VAR GLOBAL inverseFp12BLS12381_c22_y
VAR GLOBAL inverseFp12BLS12381_c23_x
VAR GLOBAL inverseFp12BLS12381_c23_y

VAR GLOBAL _a1square1_x
VAR GLOBAL _a1square1_y
VAR GLOBAL _a1square2_x
VAR GLOBAL _a1square2_y
VAR GLOBAL _a1square3_x
VAR GLOBAL _a1square3_y

VAR GLOBAL _RR

inverseFp12BLS12381:
        RR => _RR

        ; 1] c1 = a1·(a1² - a2²·v)⁻¹
        ; 1.1] a1²
        inverseFp12BLS12381_a11_x => A
        inverseFp12BLS12381_a11_y => B
        A => squareFp6BLS12381_a1_x
        B => squareFp6BLS12381_a1_y
        inverseFp12BLS12381_a12_x => A
        inverseFp12BLS12381_a12_y => B
        A => squareFp6BLS12381_a2_x
        B => squareFp6BLS12381_a2_y
        inverseFp12BLS12381_a13_x => A
        inverseFp12BLS12381_a13_y => B
        A => squareFp6BLS12381_a3_x
        B => squareFp6BLS12381_a3_y     :CALL(squareFp6BLS12381)
        squareFp6BLS12381_c1_x => A
        squareFp6BLS12381_c1_y => B
        A => _a1square1_x
        B => _a1square1_y
        squareFp6BLS12381_c2_x => A
        squareFp6BLS12381_c2_y => B
        A => _a1square2_x
        B => _a1square2_y
        squareFp6BLS12381_c3_x => A
        squareFp6BLS12381_c3_y => B
        A => _a1square3_x
        B => _a1square3_y

        ; 1.2] a2²
        inverseFp12BLS12381_a21_x => A
        inverseFp12BLS12381_a21_y => B
        A => squareFp6BLS12381_a1_x
        B => squareFp6BLS12381_a1_y
        inverseFp12BLS12381_a22_x => A
        inverseFp12BLS12381_a22_y => B
        A => squareFp6BLS12381_a2_x
        B => squareFp6BLS12381_a2_y
        inverseFp12BLS12381_a23_x => A
        inverseFp12BLS12381_a23_y => B
        A => squareFp6BLS12381_a3_x
        B => squareFp6BLS12381_a3_y     :CALL(squareFp6BLS12381)

        ; 1.3] a2²·v
        squareFp6BLS12381_c1_x => A
        squareFp6BLS12381_c1_y => B
        A => sparseMulBFp6BLS12381_a1_x
        B => sparseMulBFp6BLS12381_a1_y
        squareFp6BLS12381_c2_x => A
        squareFp6BLS12381_c2_y => B
        A => sparseMulBFp6BLS12381_a2_x
        B => sparseMulBFp6BLS12381_a2_y
        squareFp6BLS12381_c3_x => A
        squareFp6BLS12381_c3_y => B
        A => sparseMulBFp6BLS12381_a3_x
        B => sparseMulBFp6BLS12381_a3_y
        1 => sparseMulBFp6BLS12381_b2_x
        0 => sparseMulBFp6BLS12381_b2_y :CALL(sparseMulBFp6BLS12381)

        ; 1.4] a1² - a2²·v
        sparseMulBFp6BLS12381_c1_x => A
        sparseMulBFp6BLS12381_c1_y => B
        A => subFp6BLS12381_b1_x
        B => subFp6BLS12381_b1_y
        sparseMulBFp6BLS12381_c2_x => A
        sparseMulBFp6BLS12381_c2_y => B
        A => subFp6BLS12381_b2_x
        B => subFp6BLS12381_b2_y
        sparseMulBFp6BLS12381_c3_x => A
        sparseMulBFp6BLS12381_c3_y => B
        A => subFp6BLS12381_b3_x
        B => subFp6BLS12381_b3_y
        _a1square1_x => A
        _a1square1_y => B
        A => subFp6BLS12381_a1_x
        B => subFp6BLS12381_a1_y
        _a1square2_x => A
        _a1square2_y => B
        A => subFp6BLS12381_a2_x
        B => subFp6BLS12381_a2_y
        _a1square3_x => A
        _a1square3_y => B
        A => subFp6BLS12381_a3_x
        B => subFp6BLS12381_a3_y        :CALL(subFp6BLS12381)

        ; 1.5] (a1² - a2²·v)⁻¹
        subFp6BLS12381_c1_x => A
        subFp6BLS12381_c1_y => B
        A => inverseFp6BLS12381_a1_x
        B => inverseFp6BLS12381_a1_y
        subFp6BLS12381_c2_x => A
        subFp6BLS12381_c2_y => B
        A => inverseFp6BLS12381_a2_x
        B => inverseFp6BLS12381_a2_y
        subFp6BLS12381_c3_x => A
        subFp6BLS12381_c3_y => B
        A => inverseFp6BLS12381_a3_x
        B => inverseFp6BLS12381_a3_y    :CALL(inverseFp6BLS12381)

        ; 6] c1 = a1·(a1² - a2²·v)⁻¹
        inverseFp6BLS12381_c1_x => A
        inverseFp6BLS12381_c1_y => B
        A => mulFp6BLS12381_b1_x
        B => mulFp6BLS12381_b1_y
        inverseFp6BLS12381_c2_x => A
        inverseFp6BLS12381_c2_y => B
        A => mulFp6BLS12381_b2_x
        B => mulFp6BLS12381_b2_y
        inverseFp6BLS12381_c3_x => A
        inverseFp6BLS12381_c3_y => B
        A => mulFp6BLS12381_b3_x
        B => mulFp6BLS12381_b3_y
        inverseFp12BLS12381_a11_x => A
        inverseFp12BLS12381_a11_y => B
        A => mulFp6BLS12381_a1_x
        B => mulFp6BLS12381_a1_y
        inverseFp12BLS12381_a12_x => A
        inverseFp12BLS12381_a12_y => B
        A => mulFp6BLS12381_a2_x
        B => mulFp6BLS12381_a2_y
        inverseFp12BLS12381_a13_x => A
        inverseFp12BLS12381_a13_y => B
        A => mulFp6BLS12381_a3_x
        B => mulFp6BLS12381_a3_y        :CALL(mulFp6BLS12381)
        mulFp6BLS12381_c1_x => A
        mulFp6BLS12381_c1_y => B
        A => inverseFp12BLS12381_c11_x
        B => inverseFp12BLS12381_c11_y
        mulFp6BLS12381_c2_x => A
        mulFp6BLS12381_c2_y => B
        A => inverseFp12BLS12381_c12_x
        B => inverseFp12BLS12381_c12_y
        mulFp6BLS12381_c3_x => A
        mulFp6BLS12381_c3_y => B
        A => inverseFp12BLS12381_c13_x
        B => inverseFp12BLS12381_c13_y

        ; 4] c2 = -a2·(a1² - a2²·v)⁻¹
        inverseFp12BLS12381_a21_x => C
        inverseFp12BLS12381_a21_y => D  :CALL(negFp2BLS12381)
        E => mulFp6BLS12381_a1_x
        C => mulFp6BLS12381_a1_y
        inverseFp12BLS12381_a22_x => C
        inverseFp12BLS12381_a22_y => D  :CALL(negFp2BLS12381)
        E => mulFp6BLS12381_a2_x
        C => mulFp6BLS12381_a2_y
        inverseFp12BLS12381_a23_x => C
        inverseFp12BLS12381_a23_y => D  :CALL(negFp2BLS12381)
        E => mulFp6BLS12381_a3_x
        C => mulFp6BLS12381_a3_y        :CALL(mulFp6BLS12381) ; mulFp6 already contains the correct value in b
        mulFp6BLS12381_c1_x => A
        mulFp6BLS12381_c1_y => B
        A => inverseFp12BLS12381_c21_x
        B => inverseFp12BLS12381_c21_y
        mulFp6BLS12381_c2_x => A
        mulFp6BLS12381_c2_y => B
        A => inverseFp12BLS12381_c22_x
        B => inverseFp12BLS12381_c22_y
        mulFp6BLS12381_c3_x => A
        mulFp6BLS12381_c3_y => B
        A => inverseFp12BLS12381_c23_x
        B => inverseFp12BLS12381_c23_y

        _RR => RR                       :RETURN
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P) because if falls back to FP12 arithmetic
;;
;; expByXCompCycloFp12BLS12381:
;;             in: a = a0 + a2·w + a4·w² + a1·w³ + a3·w⁴ + a5·w⁵ ∈ GΦ6(p²), where ai ∈ Fp2
;;             out: a^|x| = c0 + c2·w + c4·w² + c1·w³ + c3·w⁴ + c5·w⁵ ∈ ∈ GΦ6(p²), where where |x| = 0xd201000000010000
;;
;; NOTE: The output is not guaranteed to be in GΦ6(p²), if the input isn't.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

VAR GLOBAL expByXCompCycloFp12BLS12381_a0_x
VAR GLOBAL expByXCompCycloFp12BLS12381_a0_y
VAR GLOBAL expByXCompCycloFp12BLS12381_a2_x
VAR GLOBAL expByXCompCycloFp12BLS12381_a2_y
VAR GLOBAL expByXCompCycloFp12BLS12381_a4_x
VAR GLOBAL expByXCompCycloFp12BLS12381_a4_y
VAR GLOBAL expByXCompCycloFp12BLS12381_a1_x
VAR GLOBAL expByXCompCycloFp12BLS12381_a1_y
VAR GLOBAL expByXCompCycloFp12BLS12381_a3_x
VAR GLOBAL expByXCompCycloFp12BLS12381_a3_y
VAR GLOBAL expByXCompCycloFp12BLS12381_a5_x
VAR GLOBAL expByXCompCycloFp12BLS12381_a5_y
VAR GLOBAL expByXCompCycloFp12BLS12381_c0_x
VAR GLOBAL expByXCompCycloFp12BLS12381_c0_y
VAR GLOBAL expByXCompCycloFp12BLS12381_c2_x
VAR GLOBAL expByXCompCycloFp12BLS12381_c2_y
VAR GLOBAL expByXCompCycloFp12BLS12381_c4_x
VAR GLOBAL expByXCompCycloFp12BLS12381_c4_y
VAR GLOBAL expByXCompCycloFp12BLS12381_c1_x
VAR GLOBAL expByXCompCycloFp12BLS12381_c1_y
VAR GLOBAL expByXCompCycloFp12BLS12381_c3_x
VAR GLOBAL expByXCompCycloFp12BLS12381_c3_y
VAR GLOBAL expByXCompCycloFp12BLS12381_c5_x
VAR GLOBAL expByXCompCycloFp12BLS12381_c5_y

VAR GLOBAL _RR

; TODO: unroll the loop

; RESOURCES:
; -------------------------------------------
;  [steps: 2338, bin: 29, arith: 216]                  // setup
;   + 58 * [steps: 237, bin: 0, arith: 27]             // squarings
;   + 26 * [steps: 1305, bin: 5, arith: 108]           // multiplications
;   + [steps: 26]                                      // last iteration + end
;  total (w.c.): [steps: 50040 bin: 159, arith: 4590]  // [2338 + 58*237 + 26*1305 + 26,
;                                                          29            + 26*5,
;                                                          216  + 58*27  + 26*108]
; -------------------------------------------

expByXCompCycloFp12BLS12381:
        RR => _RR

        0 => RCX

        ; Start by compressing the input C(a)
        ; Store it in the output mulFp12 for future multiplications
        expByXCompCycloFp12BLS12381_a0_x => A
        expByXCompCycloFp12BLS12381_a0_y => B
        A => compressFp12BLS12381_a0_x
        B => compressFp12BLS12381_a0_y
        expByXCompCycloFp12BLS12381_a2_x => A
        expByXCompCycloFp12BLS12381_a2_y => B
        A => compressFp12BLS12381_a2_x
        B => compressFp12BLS12381_a2_y
        expByXCompCycloFp12BLS12381_a4_x => A
        expByXCompCycloFp12BLS12381_a4_y => B
        A => compressFp12BLS12381_a4_x
        B => compressFp12BLS12381_a4_y
        expByXCompCycloFp12BLS12381_a1_x => A
        expByXCompCycloFp12BLS12381_a1_y => B
        A => compressFp12BLS12381_a1_x
        B => compressFp12BLS12381_a1_y
        expByXCompCycloFp12BLS12381_a3_x => A
        expByXCompCycloFp12BLS12381_a3_y => B
        A => compressFp12BLS12381_a3_x
        B => compressFp12BLS12381_a3_y
        expByXCompCycloFp12BLS12381_a5_x => A
        expByXCompCycloFp12BLS12381_a5_y => B
        A => compressFp12BLS12381_a5_x
        B => compressFp12BLS12381_a5_y                  :CALL(compressFp12BLS12381)
        ; [steps: 106, bin: 24, arith: 0]

        ; Store it in the output squareCompCyclo for future compressed squarings
        compressFp12BLS12381_Ca2_x => A
        compressFp12BLS12381_Ca2_y => B
        A => squareCompCycloFp12BLS12381_Cb2_x
        B => squareCompCycloFp12BLS12381_Cb2_y
        compressFp12BLS12381_Ca3_x => A
        compressFp12BLS12381_Ca3_y => B
        A => squareCompCycloFp12BLS12381_Cb3_x
        B => squareCompCycloFp12BLS12381_Cb3_y
        compressFp12BLS12381_Ca4_x => A
        compressFp12BLS12381_Ca4_y => B
        A => squareCompCycloFp12BLS12381_Cb4_x
        B => squareCompCycloFp12BLS12381_Cb4_y
        compressFp12BLS12381_Ca5_x => A
        compressFp12BLS12381_Ca5_y => B
        A => squareCompCycloFp12BLS12381_Cb5_x
        B => squareCompCycloFp12BLS12381_Cb5_y
        ; [steps: 338, bin: 24, arith: 27]

        ; Set the result to 1
        1 => mulFp12BLS12381_c11_x
        0 => mulFp12BLS12381_c11_y
        0 => mulFp12BLS12381_c12_x
        0 => mulFp12BLS12381_c12_y
        0 => mulFp12BLS12381_c13_x
        0 => mulFp12BLS12381_c13_y
        0 => mulFp12BLS12381_c21_x
        0 => mulFp12BLS12381_c21_y
        0 => mulFp12BLS12381_c22_x
        0 => mulFp12BLS12381_c22_y
        0 => mulFp12BLS12381_c23_x
        0 => mulFp12BLS12381_c23_y


_loop:
        RCX => RR                                       :JMP_EQ(64, _last)

        ; We check if the next bit is either 1 or 0
                                                        :CALL(@loopLengthBLS12381 + RR)

        ; if bit = 0, then avoid the multiplication and just square
        B                                               :JMPZ(_square)

        ; else, multiply by the last result

        ; We decompress D(C(c)) = c
        squareCompCycloFp12BLS12381_Cb2_x => A
        squareCompCycloFp12BLS12381_Cb2_y => B
        A => decompressFp12BLS12381_Ca2_x
        B => decompressFp12BLS12381_Ca2_y
        squareCompCycloFp12BLS12381_Cb3_x => A
        squareCompCycloFp12BLS12381_Cb3_y => B
        A => decompressFp12BLS12381_Ca3_x
        B => decompressFp12BLS12381_Ca3_y
        squareCompCycloFp12BLS12381_Cb4_x => A
        squareCompCycloFp12BLS12381_Cb4_y => B
        A => decompressFp12BLS12381_Ca4_x
        B => decompressFp12BLS12381_Ca4_y
        squareCompCycloFp12BLS12381_Cb5_x => A
        squareCompCycloFp12BLS12381_Cb5_y => B
        A => decompressFp12BLS12381_Ca5_x
        B => decompressFp12BLS12381_Ca5_y               :CALL(decompressFp12BLS12381)

        ; We multiply the last result with the decompressed c
        mulFp12BLS12381_c11_x => A
        mulFp12BLS12381_c11_y => B
        A => mulFp12BLS12381_a11_x
        B => mulFp12BLS12381_a11_y
        mulFp12BLS12381_c12_x => A
        mulFp12BLS12381_c12_y => B
        A => mulFp12BLS12381_a12_x
        B => mulFp12BLS12381_a12_y
        mulFp12BLS12381_c13_x => A
        mulFp12BLS12381_c13_y => B
        A => mulFp12BLS12381_a13_x
        B => mulFp12BLS12381_a13_y
        mulFp12BLS12381_c21_x => A
        mulFp12BLS12381_c21_y => B
        A => mulFp12BLS12381_a21_x
        B => mulFp12BLS12381_a21_y
        mulFp12BLS12381_c22_x => A
        mulFp12BLS12381_c22_y => B
        A => mulFp12BLS12381_a22_x
        B => mulFp12BLS12381_a22_y
        mulFp12BLS12381_c23_x => A
        mulFp12BLS12381_c23_y => B
        A => mulFp12BLS12381_a23_x
        B => mulFp12BLS12381_a23_y
        decompressFp12BLS12381_a0_x => A
        decompressFp12BLS12381_a0_y => B
        A => mulFp12BLS12381_b11_x
        B => mulFp12BLS12381_b11_y
        decompressFp12BLS12381_a2_x => A
        decompressFp12BLS12381_a2_y => B
        A => mulFp12BLS12381_b21_x
        B => mulFp12BLS12381_b21_y
        decompressFp12BLS12381_a4_x => A
        decompressFp12BLS12381_a4_y => B
        A => mulFp12BLS12381_b12_x
        B => mulFp12BLS12381_b12_y
        decompressFp12BLS12381_a1_x => A
        decompressFp12BLS12381_a1_y => B
        A => mulFp12BLS12381_b22_x
        B => mulFp12BLS12381_b22_y
        decompressFp12BLS12381_a3_x => A
        decompressFp12BLS12381_a3_y => B
        A => mulFp12BLS12381_b13_x
        B => mulFp12BLS12381_b13_y
        decompressFp12BLS12381_a5_x => A
        decompressFp12BLS12381_a5_y => B
        A => mulFp12BLS12381_b23_x
        B => mulFp12BLS12381_b23_y                      :CALL(mulFp12BLS12381)

_square:
        ; We always square C(c)
        squareCompCycloFp12BLS12381_Cb2_x => A
        squareCompCycloFp12BLS12381_Cb2_y => B
        A => squareCompCycloFp12BLS12381_Ca2_x
        B => squareCompCycloFp12BLS12381_Ca2_y
        squareCompCycloFp12BLS12381_Cb3_x => A
        squareCompCycloFp12BLS12381_Cb3_y => B
        A => squareCompCycloFp12BLS12381_Ca3_x
        B => squareCompCycloFp12BLS12381_Ca3_y
        squareCompCycloFp12BLS12381_Cb4_x => A
        squareCompCycloFp12BLS12381_Cb4_y => B
        A => squareCompCycloFp12BLS12381_Ca4_x
        B => squareCompCycloFp12BLS12381_Ca4_y
        squareCompCycloFp12BLS12381_Cb5_x => A
        squareCompCycloFp12BLS12381_Cb5_y => B
        A => squareCompCycloFp12BLS12381_Ca5_x
        B => squareCompCycloFp12BLS12381_Ca5_y          :CALL(squareCompCycloFp12BLS12381)

        ; update the index
        RCX + 1 => RCX                                  :JMP(_loop)

_last:
        ; block costs till end: [steps: 26, bin: 0, arith: 0]

        ; Last asignment
        mulFp12BLS12381_c11_x => A
        mulFp12BLS12381_c11_y => B
        A => expByXCompCycloFp12BLS12381_c0_x
        B => expByXCompCycloFp12BLS12381_c0_y
        mulFp12BLS12381_c12_x => A
        mulFp12BLS12381_c12_y => B
        A => expByXCompCycloFp12BLS12381_c4_x
        B => expByXCompCycloFp12BLS12381_c4_y
        mulFp12BLS12381_c13_x => A
        mulFp12BLS12381_c13_y => B
        A => expByXCompCycloFp12BLS12381_c3_x
        B => expByXCompCycloFp12BLS12381_c3_y
        mulFp12BLS12381_c21_x => A
        mulFp12BLS12381_c21_y => B
        A => expByXCompCycloFp12BLS12381_c2_x
        B => expByXCompCycloFp12BLS12381_c2_y
        mulFp12BLS12381_c22_x => A
        mulFp12BLS12381_c22_y => B
        A => expByXCompCycloFp12BLS12381_c1_x
        B => expByXCompCycloFp12BLS12381_c1_y
        mulFp12BLS12381_c23_x => A
        mulFp12BLS12381_c23_y => B
        A => expByXCompCycloFp12BLS12381_c5_x
        B => expByXCompCycloFp12BLS12381_c5_y

        _RR => RR                               :RETURN

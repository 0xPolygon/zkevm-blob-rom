;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P) because if falls back to FP2 arithmetic
;;
;; squareCompCycloFp12BLS12381:
;;             in: [a2,a3,a4,a5] ∈ Fp2⁴, where ai ∈ Fp2
;;             out: C(a²) = [b2, b3, b4, b5] ∈ Fp2⁴, where:
;;                  - b2 = 2(a2 + 3·(1+u)·B45)
;;                  - b3 = 3·(A45 - (10+u)·B45) - 2·a3
;;                  - b4 = 3·(A23 - (10+u)·B23) - 2·a4
;;                  - b5 = 2·(a5 + 3·B23)
;;                 - A23 = (a2 + a3)·(a2 + (1+u)·a3)
;;                 - A45 = (a4 + a5)·(a4 + (1+u)·a5)
;;                 - B23 = a2·a3
;;                 - B45 = a4·a5
;;
;; NOTE: If the input is not of the form C(a), where a ∈ GΦ6(p²), then the compression-decompression
;;       technique will not be well defined after the squaring. This means that D(C(a²)) != a².
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

VAR GLOBAL squareCompCycloFp12BLS12381_Ca2_x
VAR GLOBAL squareCompCycloFp12BLS12381_Ca2_y
VAR GLOBAL squareCompCycloFp12BLS12381_Ca3_x
VAR GLOBAL squareCompCycloFp12BLS12381_Ca3_y
VAR GLOBAL squareCompCycloFp12BLS12381_Ca4_x
VAR GLOBAL squareCompCycloFp12BLS12381_Ca4_y
VAR GLOBAL squareCompCycloFp12BLS12381_Ca5_x
VAR GLOBAL squareCompCycloFp12BLS12381_Ca5_y
VAR GLOBAL squareCompCycloFp12BLS12381_Cb2_x
VAR GLOBAL squareCompCycloFp12BLS12381_Cb2_y
VAR GLOBAL squareCompCycloFp12BLS12381_Cb3_x
VAR GLOBAL squareCompCycloFp12BLS12381_Cb3_y
VAR GLOBAL squareCompCycloFp12BLS12381_Cb4_x
VAR GLOBAL squareCompCycloFp12BLS12381_Cb4_y
VAR GLOBAL squareCompCycloFp12BLS12381_Cb5_x
VAR GLOBAL squareCompCycloFp12BLS12381_Cb5_y

VAR GLOBAL _B23_x
VAR GLOBAL _B23_y
VAR GLOBAL _B45_x
VAR GLOBAL _B45_y
VAR GLOBAL _A23_x
VAR GLOBAL _A23_y
VAR GLOBAL _A45_x
VAR GLOBAL _A45_y

VAR GLOBAL _A23right_x
VAR GLOBAL _A23right_y
VAR GLOBAL _A45right_x
VAR GLOBAL _A45right_y

VAR GLOBAL _twoCa3_x
VAR GLOBAL _twoCa3_y

VAR GLOBAL _twoCa4_x
VAR GLOBAL _twoCa4_y

VAR GLOBAL _RR

; RESOURCES:
; -----------------------------
; [steps: 216, bin: 0, arith: 27]
; -----------------------------

squareCompCycloFp12BLS12381:
        RR => _RR

        ; 1] B23 = a2·a3, B45 = a4·a5
        squareCompCycloFp12BLS12381_Ca2_x => A
        squareCompCycloFp12BLS12381_Ca2_y => B
        squareCompCycloFp12BLS12381_Ca3_x => C
        squareCompCycloFp12BLS12381_Ca3_y => D  :CALL(mulFp2BLS12381)
        E => _B23_x
        C => _B23_y

        squareCompCycloFp12BLS12381_Ca4_x => A
        squareCompCycloFp12BLS12381_Ca4_y => B
        squareCompCycloFp12BLS12381_Ca5_x => C
        squareCompCycloFp12BLS12381_Ca5_y => D  :CALL(mulFp2BLS12381)
        E => _B45_x
        C => _B45_y

        ; 2] A23 = (a2 + a3)·(a2 + (1+u)·a3)
        %BLS12381_EXT_X => A
        %BLS12381_EXT_Y => B
        squareCompCycloFp12BLS12381_Ca3_x => C
        squareCompCycloFp12BLS12381_Ca3_y => D  :CALL(mulFp2BLS12381)
        E => A
        C => B
        squareCompCycloFp12BLS12381_Ca2_x => C
        squareCompCycloFp12BLS12381_Ca2_y => D  :CALL(addFp2BLS12381)
        E => _A23right_x
        C => _A23right_y

        squareCompCycloFp12BLS12381_Ca2_x => A
        squareCompCycloFp12BLS12381_Ca2_y => B
        squareCompCycloFp12BLS12381_Ca3_x => C
        squareCompCycloFp12BLS12381_Ca3_y => D  :CALL(addFp2BLS12381)
        E => A
        C => B
        _A23right_x => C
        _A23right_y => D                        :CALL(mulFp2BLS12381)
        E => _A23_x
        C => _A23_y

        ; 3] A45 = (a4 + a5)·(a4 + (1+u)·a5)
        %BLS12381_EXT_X => A
        %BLS12381_EXT_Y => B
        squareCompCycloFp12BLS12381_Ca5_x => C
        squareCompCycloFp12BLS12381_Ca5_y => D  :CALL(mulFp2BLS12381)
        E => A
        C => B
        squareCompCycloFp12BLS12381_Ca4_x => C
        squareCompCycloFp12BLS12381_Ca4_y => D  :CALL(addFp2BLS12381)
        E => _A45right_x
        C => _A45right_y

        squareCompCycloFp12BLS12381_Ca4_x => A
        squareCompCycloFp12BLS12381_Ca4_y => B
        squareCompCycloFp12BLS12381_Ca5_x => C
        squareCompCycloFp12BLS12381_Ca5_y => D  :CALL(addFp2BLS12381)
        E => A
        C => B
        _A45right_x => C
        _A45right_y => D                        :CALL(mulFp2BLS12381)
        E => _A45_x
        C => _A45_y

        ; 4] b2 = 2(a2 + 3·(1+u)·B45)
        %BLS12381_EXT_X => A
        %BLS12381_EXT_Y => B
        _B45_x => C
        _B45_y => D                             :CALL(mulFp2BLS12381)
        3n => A
        C => D
        E => C                                  :CALL(scalarMulFp2BLS12381)
        E => A
        C => B
        squareCompCycloFp12BLS12381_Ca2_x => C
        squareCompCycloFp12BLS12381_Ca2_y => D  :CALL(addFp2BLS12381)
        2n => A
        C => D
        E => C                                  :CALL(scalarMulFp2BLS12381)
        E => squareCompCycloFp12BLS12381_Cb2_x
        C => squareCompCycloFp12BLS12381_Cb2_y

        ; 5] b3 = 3·(A45 - (10+u)·B45) - 2·a3
        2n => A
        squareCompCycloFp12BLS12381_Ca3_x => C
        squareCompCycloFp12BLS12381_Ca3_y => D  :CALL(scalarMulFp2BLS12381)
        E => _twoCa3_x
        C => _twoCa3_y

        10n => A
        1n => B
        _B45_x => C
        _B45_y => D                             :CALL(mulFp2BLS12381)
        _A45_x => A
        _A45_y => B
        C => D
        E => C                                  :CALL(subFp2BLS12381)

        3n => A
        C => D
        E => C                                  :CALL(scalarMulFp2BLS12381)

        E => A
        C => B
        _twoCa3_x => C
        _twoCa3_y => D                          :CALL(subFp2BLS12381)
        E => squareCompCycloFp12BLS12381_Cb3_x
        C => squareCompCycloFp12BLS12381_Cb3_y

        ; 6] b4 = 3·(A23 - (10+u)·B23) - 2·a4
        2n => A
        squareCompCycloFp12BLS12381_Ca4_x => C
        squareCompCycloFp12BLS12381_Ca4_y => D  :CALL(scalarMulFp2BLS12381)
        E => _twoCa4_x
        C => _twoCa4_y

        10n => A
        1n => B
        _B23_x => C
        _B23_y => D                             :CALL(mulFp2BLS12381)
        _A23_x => A
        _A23_y => B
        C => D
        E => C                                  :CALL(subFp2BLS12381)

        3n => A
        C => D
        E => C                                  :CALL(scalarMulFp2BLS12381)

        E => A
        C => B
        _twoCa4_x => C
        _twoCa4_y => D                          :CALL(subFp2BLS12381)
        E => squareCompCycloFp12BLS12381_Cb4_x
        C => squareCompCycloFp12BLS12381_Cb4_y

        ; 7] b5 = 2·(a5 + 3·B23)
        3n => A
        _B23_x => C
        _B23_y => D                             :CALL(scalarMulFp2BLS12381)
        E => A
        C => B
        squareCompCycloFp12BLS12381_Ca5_x => C
        squareCompCycloFp12BLS12381_Ca5_y => D  :CALL(addFp2BLS12381)
        2n => A
        C => D
        E => C                                  :CALL(scalarMulFp2BLS12381)

        E => squareCompCycloFp12BLS12381_Cb5_x
        C => squareCompCycloFp12BLS12381_Cb5_y

        _RR => RR                               :RETURN

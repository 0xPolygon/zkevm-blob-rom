;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; compressFp12BLS12381:
;;             in: a = a0 + a2·w + a4·w² + a1·w³ + a3·w⁴ + a5·w⁵ ∈ GΦ6(p²), where ai ∈ Fp2
;;             out: C(a) = [a2,a3,a4,a5] ∈ Fp2⁴
;;
;; NOTE: If the input does not belong to the cyclotomic subgroup GΦ6(p²), then the compression-decompression
;;       technique is not well defined. This means that D(C(a)) != a.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

VAR GLOBAL compressFp12BLS12381_a0_x
VAR GLOBAL compressFp12BLS12381_a0_y
VAR GLOBAL compressFp12BLS12381_a2_x
VAR GLOBAL compressFp12BLS12381_a2_y
VAR GLOBAL compressFp12BLS12381_a4_x
VAR GLOBAL compressFp12BLS12381_a4_y
VAR GLOBAL compressFp12BLS12381_a1_x
VAR GLOBAL compressFp12BLS12381_a1_y
VAR GLOBAL compressFp12BLS12381_a3_x
VAR GLOBAL compressFp12BLS12381_a3_y
VAR GLOBAL compressFp12BLS12381_a5_x
VAR GLOBAL compressFp12BLS12381_a5_y
VAR GLOBAL compressFp12BLS12381_Ca2_x
VAR GLOBAL compressFp12BLS12381_Ca2_y
VAR GLOBAL compressFp12BLS12381_Ca3_x
VAR GLOBAL compressFp12BLS12381_Ca3_y
VAR GLOBAL compressFp12BLS12381_Ca4_x
VAR GLOBAL compressFp12BLS12381_Ca4_y
VAR GLOBAL compressFp12BLS12381_Ca5_x
VAR GLOBAL compressFp12BLS12381_Ca5_y

; RESOURCES:
; -----------------------------
; [steps: 16, bin: 0, arith: 0]
; -----------------------------

compressFp12BLS12381:
        compressFp12BLS12381_a2_x => A
        compressFp12BLS12381_a2_y => B
        A => compressFp12BLS12381_Ca2_x
        B => compressFp12BLS12381_Ca2_y
        compressFp12BLS12381_a3_x => A
        compressFp12BLS12381_a3_y => B
        A => compressFp12BLS12381_Ca3_x
        B => compressFp12BLS12381_Ca3_y
        compressFp12BLS12381_a4_x => A
        compressFp12BLS12381_a4_y => B
        A => compressFp12BLS12381_Ca4_x
        B => compressFp12BLS12381_Ca4_y
        compressFp12BLS12381_a5_x => A
        compressFp12BLS12381_a5_y => B
        A => compressFp12BLS12381_Ca5_x
        B => compressFp12BLS12381_Ca5_y         :RETURN
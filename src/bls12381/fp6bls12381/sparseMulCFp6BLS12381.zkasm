;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P) because if falls back to FP2 arithmetic
;;
;; sparseMulCFp6BLS12381:
;;             in: (a1 + a2·v + a3·v²),(b1 + b2·v) ∈ Fp6, where ai,bi ∈ Fp2
;;             out: (c1 + c2·v + c3·v²) ∈ Fp6, where:
;;                  - c1 = a1·b1 + a3·b2·(1+u)
;;                  - c2 = a1·b2 + a2·b1
;;                  - c3 = a2·b2 + a3·b1
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

VAR GLOBAL sparseMulCFp6BLS12381_a1_x
VAR GLOBAL sparseMulCFp6BLS12381_a1_y
VAR GLOBAL sparseMulCFp6BLS12381_a2_x
VAR GLOBAL sparseMulCFp6BLS12381_a2_y
VAR GLOBAL sparseMulCFp6BLS12381_a3_x
VAR GLOBAL sparseMulCFp6BLS12381_a3_y

VAR GLOBAL sparseMulCFp6BLS12381_b1_x
VAR GLOBAL sparseMulCFp6BLS12381_b1_y
VAR GLOBAL sparseMulCFp6BLS12381_b2_x
VAR GLOBAL sparseMulCFp6BLS12381_b2_y

VAR GLOBAL sparseMulCFp6BLS12381_c1_x
VAR GLOBAL sparseMulCFp6BLS12381_c1_y
VAR GLOBAL sparseMulCFp6BLS12381_c2_x
VAR GLOBAL sparseMulCFp6BLS12381_c2_y
VAR GLOBAL sparseMulCFp6BLS12381_c3_x
VAR GLOBAL sparseMulCFp6BLS12381_c3_y

VAR GLOBAL _a1b1_x
VAR GLOBAL _a1b1_y
VAR GLOBAL _a1b2_x
VAR GLOBAL _a1b2_y
VAR GLOBAL _a2b2_x
VAR GLOBAL _a2b2_y

VAR GLOBAL _RR

; RESOURCES:
; -----------------------------
; [steps: 108, bin: 0, arith: 13]
; -----------------------------

sparseMulCFp6BLS12381:
        RR => _RR

        ; 1] c1 = a1·b1 + a3·b2·(1+u)
        sparseMulCFp6BLS12381_a1_x => A
        sparseMulCFp6BLS12381_a1_y => B
        sparseMulCFp6BLS12381_b1_x => C
        sparseMulCFp6BLS12381_b1_y => D :CALL(mulFp2BLS12381)
        E => _a1b1_x
        C => _a1b1_y

        sparseMulCFp6BLS12381_a3_x => A
        sparseMulCFp6BLS12381_a3_y => B
        sparseMulCFp6BLS12381_b2_x => C
        sparseMulCFp6BLS12381_b2_y => D :CALL(mulFp2BLS12381)

        E => A
        C => B
        %BLS12_381_EXT_X => C
        %BLS12_381_EXT_Y => D            :CALL(mulFp2BLS12381)

        E => A
        C => B
        _a1b1_x => C
        _a1b1_y => D                    :CALL(addFp2BLS12381)
        E => sparseMulCFp6BLS12381_c1_x
        C => sparseMulCFp6BLS12381_c1_y

        ; 2] c2 = a1·b2 + a2·b1
        sparseMulCFp6BLS12381_a1_x => A
        sparseMulCFp6BLS12381_a1_y => B
        sparseMulCFp6BLS12381_b2_x => C
        sparseMulCFp6BLS12381_b2_y => D :CALL(mulFp2BLS12381)
        E => _a1b2_x
        C => _a1b2_y

        sparseMulCFp6BLS12381_a2_x => A
        sparseMulCFp6BLS12381_a2_y => B
        sparseMulCFp6BLS12381_b1_x => C
        sparseMulCFp6BLS12381_b1_y => D :CALL(mulFp2BLS12381)

        E => A
        C => B
        _a1b2_x => C
        _a1b2_y => D                    :CALL(addFp2BLS12381)
        E => sparseMulCFp6BLS12381_c2_x
        C => sparseMulCFp6BLS12381_c2_y


        ; 3] c3 = a2·b2 + a3·b1
        sparseMulCFp6BLS12381_a2_x => A
        sparseMulCFp6BLS12381_a2_y => B
        sparseMulCFp6BLS12381_b2_x => C
        sparseMulCFp6BLS12381_b2_y => D :CALL(mulFp2BLS12381)
        E => _a2b2_x
        C => _a2b2_y

        sparseMulCFp6BLS12381_a3_x => A
        sparseMulCFp6BLS12381_a3_y => B
        sparseMulCFp6BLS12381_b1_x => C
        sparseMulCFp6BLS12381_b1_y => D :CALL(mulFp2BLS12381)

        E => A
        C => B
        _a2b2_x => C
        _a2b2_y => D                    :CALL(addFp2BLS12381)
        E => sparseMulCFp6BLS12381_c3_x
        C => sparseMulCFp6BLS12381_c3_y

        _RR => RR                       :RETURN
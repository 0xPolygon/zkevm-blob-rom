;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P) because if falls back to FP2 arithmetic
;;
;; scalarMulFp6BLS12381:
;;             in: b ∈ Fp, (a1 + a2·v + a3·v²) ∈ Fp6, where ai ∈ Fp2
;;             out: (c1 + c2·v + c3·v²) = (a1·b) + (a2·b)·v + (a3·b)·v² ∈ Fp6
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

VAR GLOBAL scalarMulFp6BLS12381_a1_x
VAR GLOBAL scalarMulFp6BLS12381_a1_y
VAR GLOBAL scalarMulFp6BLS12381_a2_x
VAR GLOBAL scalarMulFp6BLS12381_a2_y
VAR GLOBAL scalarMulFp6BLS12381_a3_x
VAR GLOBAL scalarMulFp6BLS12381_a3_y
VAR GLOBAL scalarMulFp6BLS12381_b
VAR GLOBAL scalarMulFp6BLS12381_c1_x
VAR GLOBAL scalarMulFp6BLS12381_c1_y
VAR GLOBAL scalarMulFp6BLS12381_c2_x
VAR GLOBAL scalarMulFp6BLS12381_c2_y
VAR GLOBAL scalarMulFp6BLS12381_c3_x
VAR GLOBAL scalarMulFp6BLS12381_c3_y

VAR GLOBAL _RR

scalarMulFp6BLS12381:
        RR => _RR

        ; 1] c1 = a1·b
        scalarMulFp6BLS12381_b => A
        scalarMulFp6BLS12381_a1_x => C
        scalarMulFp6BLS12381_a1_y => D  :CALL(scalarMulFp2BLS12381)
        E => scalarMulFp6BLS12381_c1_x
        C => scalarMulFp6BLS12381_c1_y

        ; 2] c2 = a2·b
        scalarMulFp6BLS12381_b => A
        scalarMulFp6BLS12381_a2_x => C
        scalarMulFp6BLS12381_a2_y => D  :CALL(scalarMulFp2BLS12381)
        E => scalarMulFp6BLS12381_c2_x
        C => scalarMulFp6BLS12381_c2_y

        ; 3] c3 = a3·b
        scalarMulFp6BLS12381_b => A
        scalarMulFp6BLS12381_a3_x => C
        scalarMulFp6BLS12381_a3_y => D  :CALL(scalarMulFp2BLS12381)
        E => scalarMulFp6BLS12381_c3_x
        C => scalarMulFp6BLS12381_c3_y

        _RR => RR                       :RETURN
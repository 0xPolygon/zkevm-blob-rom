;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12381_P) because if falls back to FP2 arithmetic
;;
;; sparseMulBFp6BLS12381:
;;             in: (a1 + a2·v + a3·v²),(b2·v + b3·v²) ∈ Fp6, where ai,bi ∈ Fp2
;;             out: (c1 + c2·v + c3·v²) ∈ Fp6, where:
;;                  - c1 = [(a2 + a3)·(b2 + b3) - a2·b2 - a3·b3]·(1+u)
;;                  - c2 = a1·b2 + a3·b3·(1+u)
;;                  - c3 = (a1 + a3)·b3 - a3·b3 + a2·b2
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

VAR GLOBAL sparseMulBFp6BLS12381_a1_x
VAR GLOBAL sparseMulBFp6BLS12381_a1_y
VAR GLOBAL sparseMulBFp6BLS12381_a2_x
VAR GLOBAL sparseMulBFp6BLS12381_a2_y
VAR GLOBAL sparseMulBFp6BLS12381_a3_x
VAR GLOBAL sparseMulBFp6BLS12381_a3_y

VAR GLOBAL sparseMulBFp6BLS12381_b2_x
VAR GLOBAL sparseMulBFp6BLS12381_b2_y
VAR GLOBAL sparseMulBFp6BLS12381_b3_x
VAR GLOBAL sparseMulBFp6BLS12381_b3_y

VAR GLOBAL sparseMulBFp6BLS12381_c1_x
VAR GLOBAL sparseMulBFp6BLS12381_c1_y
VAR GLOBAL sparseMulBFp6BLS12381_c2_x
VAR GLOBAL sparseMulBFp6BLS12381_c2_y
VAR GLOBAL sparseMulBFp6BLS12381_c3_x
VAR GLOBAL sparseMulBFp6BLS12381_c3_y

VAR GLOBAL _a2b2_x
VAR GLOBAL _a2b2_y
VAR GLOBAL _a2b2_x
VAR GLOBAL _a2b2_y
VAR GLOBAL _a2a3sum_x
VAR GLOBAL _a2a3sum_y
VAR GLOBAL _a1b2_x
VAR GLOBAL _a1b2_y

VAR GLOBAL _RR

; RESOURCES:
; -----------------------------
; [steps: 122, bin: 0, arith: 16]
; -----------------------------

sparseMulBFp6BLS12381:
        RR => _RR

        ; 1] a2·b2, a3·b3
        sparseMulBFp6BLS12381_a2_x => A
        sparseMulBFp6BLS12381_a2_y => B
        sparseMulBFp6BLS12381_b2_x => C
        sparseMulBFp6BLS12381_b2_y => D :CALL(mulFp2BLS12381)
        E => _a2b2_x
        C => _a2b2_y

        sparseMulBFp6BLS12381_a3_x => A
        sparseMulBFp6BLS12381_a3_y => B
        sparseMulBFp6BLS12381_b3_x => C
        sparseMulBFp6BLS12381_b3_y => D :CALL(mulFp2BLS12381)
        E => _a2b2_x
        C => _a2b2_y

        ; 2] c1 = ((a2 + a3)·(b2 + b3) - a2·b2 - a3·b3)·(1+u)
        sparseMulBFp6BLS12381_a2_x => A
        sparseMulBFp6BLS12381_a2_y => B
        sparseMulBFp6BLS12381_a3_x => C
        sparseMulBFp6BLS12381_a3_y => D :CALL(addFp2BLS12381)
        E => _a2a3sum_x
        C => _a2a3sum_y

        sparseMulBFp6BLS12381_b2_x => A
        sparseMulBFp6BLS12381_b2_y => B
        sparseMulBFp6BLS12381_b3_x => C
        sparseMulBFp6BLS12381_b3_y => D :CALL(addFp2BLS12381)

        E => A
        C => B
        _a2a3sum_x => C
        _a2a3sum_y => D                 :CALL(mulFp2BLS12381)

        E => A
        C => B
        _a2b2_x => C
        _a2b2_y => D                    :CALL(subFp2BLS12381)

        E => A
        C => B
        _a2b2_x => C
        _a2b2_y => D                    :CALL(subFp2BLS12381)

        E => A
        C => B
        %BLS12381_EXT_X => C
        %BLS12381_EXT_Y => D            :CALL(mulFp2BLS12381)
        E => sparseMulBFp6BLS12381_c1_x
        C => sparseMulBFp6BLS12381_c1_y

        ; 3] c2 = a1·b2 + a3·b3·(1+u)
        sparseMulBFp6BLS12381_a1_x => A
        sparseMulBFp6BLS12381_a1_y => B
        sparseMulBFp6BLS12381_b2_x => C
        sparseMulBFp6BLS12381_b2_y => D :CALL(mulFp2BLS12381)
        E => _a1b2_x
        C => _a1b2_y

        _a2b2_x => A
        _a2b2_y => B
        %BLS12381_EXT_X => C
        %BLS12381_EXT_Y => D            :CALL(mulFp2BLS12381)

        E => A
        C => B
        _a1b2_x => C
        _a1b2_y => D                    :CALL(addFp2BLS12381)
        E => sparseMulBFp6BLS12381_c2_x
        C => sparseMulBFp6BLS12381_c2_y

        ; 4] c3 = (a1 + a3)·b3 - a3·b3 + a2·b2
        sparseMulBFp6BLS12381_a1_x => A
        sparseMulBFp6BLS12381_a1_y => B
        sparseMulBFp6BLS12381_a3_x => C
        sparseMulBFp6BLS12381_a3_y => D :CALL(addFp2BLS12381)

        E => A
        C => B
        sparseMulBFp6BLS12381_b3_x => C
        sparseMulBFp6BLS12381_b3_y => D :CALL(mulFp2BLS12381)

        E => A
        C => B
        _a2b2_x => C
        _a2b2_y => D                    :CALL(subFp2BLS12381)

        E => A
        C => B
        _a2b2_x => C
        _a2b2_y => D                    :CALL(addFp2BLS12381)
        E => sparseMulBFp6BLS12381_c3_x
        C => sparseMulBFp6BLS12381_c3_y

        _RR => RR                       :RETURN
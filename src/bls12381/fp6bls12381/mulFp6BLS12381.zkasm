;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P) because if falls back to FP2 arithmetic
;;
;; mulFp6BLS12381:
;;             in: (a1 + a2·v + a3·v²),(b1 + b2·v + b3·v²) ∈ Fp6, where ai,bi ∈ Fp2
;;             out: (c1 + c2·v + c3·v²) ∈ Fp6, where:
;;                  - c1 = a1·b1 + [a2·b3 + a3·b2]·(1+u)
;;                  - c2 = a1·b2 + a2·b1 + (a3·b3)·(1+u)
;;                  - c3 = a1·b3 + a2·b2 + a3·b1
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

VAR GLOBAL mulFp6BLS12381_a1_x
VAR GLOBAL mulFp6BLS12381_a1_y
VAR GLOBAL mulFp6BLS12381_a2_x
VAR GLOBAL mulFp6BLS12381_a2_y
VAR GLOBAL mulFp6BLS12381_a3_x
VAR GLOBAL mulFp6BLS12381_a3_y
VAR GLOBAL mulFp6BLS12381_b1_x
VAR GLOBAL mulFp6BLS12381_b1_y
VAR GLOBAL mulFp6BLS12381_b2_x
VAR GLOBAL mulFp6BLS12381_b2_y
VAR GLOBAL mulFp6BLS12381_b3_x
VAR GLOBAL mulFp6BLS12381_b3_y
VAR GLOBAL mulFp6BLS12381_c1_x
VAR GLOBAL mulFp6BLS12381_c1_y
VAR GLOBAL mulFp6BLS12381_c2_x
VAR GLOBAL mulFp6BLS12381_c2_y
VAR GLOBAL mulFp6BLS12381_c3_x
VAR GLOBAL mulFp6BLS12381_c3_y

VAR GLOBAL _a2b3mul_x
VAR GLOBAL _a2b3mul_y
VAR GLOBAL _a1b2mul_x
VAR GLOBAL _a1b2mul_y
VAR GLOBAL _a1b1mul_x
VAR GLOBAL _a1b1mul_y
VAR GLOBAL _a2b1mul_x
VAR GLOBAL _a2b1mul_y
VAR GLOBAL _a1b3mul_x
VAR GLOBAL _a1b3mul_y
VAR GLOBAL _a2b2mul_x
VAR GLOBAL _a2b2mul_y

VAR GLOBAL _RR

mulFp6BLS12381:
        RR => _RR

        ; 1] c1 = a1·b1 + [a2·b3 + a3·b2]·(1+u)
        ; a1·b1
        mulFp6BLS12381_a1_x => A
        mulFp6BLS12381_a1_y => B
        mulFp6BLS12381_b1_x => C
        mulFp6BLS12381_b1_y => D        :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        E => _a1b1mul_x
        C => _a1b1mul_y

        ; [a2·b3 + a3·b2]·(1+u)
        mulFp6BLS12381_a2_x => A
        mulFp6BLS12381_a2_y => B
        mulFp6BLS12381_b3_x => C
        mulFp6BLS12381_b3_y => D        :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        E => _a2b3mul_x
        C => _a2b3mul_y

        mulFp6BLS12381_a3_x => A
        mulFp6BLS12381_a3_y => B
        mulFp6BLS12381_b2_x => C
        mulFp6BLS12381_b2_y => D        :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]

        _a2b3mul_x => A
        _a2b3mul_y => B
        C => D
        E => C                          :CALL(addFp2BLS12381) ; in: [A,B,C,D] out: [E,C]

        E => A
        C => B
        %BLS12_381_EXT_X => C
        %BLS12_381_EXT_Y => D            :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]

        ; c1 = a1·b1 + [a2·b3 + a3·b2]·(1+u)
        _a1b1mul_x => A
        _a1b1mul_y => B
        C => D
        E => C                          :CALL(addFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        E => mulFp6BLS12381_c1_x
        C => mulFp6BLS12381_c1_y

        ; 2] c2 = a1·b2 + a2·b1 + (a3·b3)·(1+u)
        ; a1·b2
        mulFp6BLS12381_a1_x => A
        mulFp6BLS12381_a1_y => B
        mulFp6BLS12381_b2_x => C
        mulFp6BLS12381_b2_y => D        :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        E => _a1b2mul_x
        C => _a1b2mul_y

        ; a2·b1
        mulFp6BLS12381_a2_x => A
        mulFp6BLS12381_a2_y => B
        mulFp6BLS12381_b1_x => C
        mulFp6BLS12381_b1_y => D        :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        E => _a2b1mul_x
        C => _a2b1mul_y

        ; (a3·b3)·(1+u)
        mulFp6BLS12381_a3_x => A
        mulFp6BLS12381_a3_y => B
        mulFp6BLS12381_b3_x => C
        mulFp6BLS12381_b3_y => D        :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]

        E => A
        C => B
        %BLS12_381_EXT_X => C
        %BLS12_381_EXT_Y => D            :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]

        ; c2 = a1·b2 + a2·b1 + (a3·b3)·(1+u)
        _a2b1mul_x => A
        _a2b1mul_y => B
        C => D
        E => C                          :CALL(addFp2BLS12381) ; in: [A,B,C,D] out: [E,C]

        _a1b2mul_x => A
        _a1b2mul_y => B
        C => D
        E => C                          :CALL(addFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        E => mulFp6BLS12381_c2_x
        C => mulFp6BLS12381_c2_y

        ; 3] c3 = a1·b3 + a2·b2 + a3·b1
        ; a1·b3
        mulFp6BLS12381_a1_x => A
        mulFp6BLS12381_a1_y => B
        mulFp6BLS12381_b3_x => C
        mulFp6BLS12381_b3_y => D        :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        E => _a1b3mul_x
        C => _a1b3mul_y

        ; a2·b2
        mulFp6BLS12381_a2_x => A
        mulFp6BLS12381_a2_y => B
        mulFp6BLS12381_b2_x => C
        mulFp6BLS12381_b2_y => D        :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        E => _a2b2mul_x
        C => _a2b2mul_y

        ; a3·b1
        mulFp6BLS12381_a3_x => A
        mulFp6BLS12381_a3_y => B
        mulFp6BLS12381_b1_x => C
        mulFp6BLS12381_b1_y => D        :CALL(mulFp2BLS12381) ; in: [A,B,C,D] out: [E,C]

        ; c3 = a1·b3 + a2·b2 + a3·b1
        _a2b2mul_x => A
        _a2b2mul_y => B
        C => D
        E => C                          :CALL(addFp2BLS12381) ; in: [A,B,C,D] out: [E,C]

        _a1b3mul_x => A
        _a1b3mul_y => B
        C => D
        E => C                          :CALL(addFp2BLS12381) ; in: [A,B,C,D] out: [E,C]
        E => mulFp6BLS12381_c3_x
        C => mulFp6BLS12381_c3_y

        _RR => RR                       :RETURN
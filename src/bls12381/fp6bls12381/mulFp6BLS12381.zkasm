;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P) because if falls back to FP2 arithmetic
;;
;; mulFp6BLS12381:
;;             in: (a1 + a2·v + a3·v²),(b1 + b2·v + b3·v²) ∈ Fp6, where ai,bi ∈ Fp2
;;             out: (c1 + c2·v + c3·v²) ∈ Fp6, where:
;;                  - c1 = [(a2+a3)·(b2+b3) - a2·b2 - a3·b3]·(1+u) + a1·b1
;;                  - c2 = (a1+a2)·(b1+b2) - a1·b1 - a2·b2 + (1+u)·(a3·b3)
;;                  - c3 = (a1+a3)·(b1+b3) - a1·b1 + a2·b2 - a3·b3
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

VAR GLOBAL mulFp6BLS12381_a1_x
VAR GLOBAL mulFp6BLS12381_a1_y
VAR GLOBAL mulFp6BLS12381_a2_x
VAR GLOBAL mulFp6BLS12381_a2_y
VAR GLOBAL mulFp6BLS12381_a3_x
VAR GLOBAL mulFp6BLS12381_a3_y
VAR GLOBAL mulFp6BLS12381_b1_x
VAR GLOBAL mulFp6BLS12381_b1_y
VAR GLOBAL mulFp6BLS12381_b2_x
VAR GLOBAL mulFp6BLS12381_b2_y
VAR GLOBAL mulFp6BLS12381_b3_x
VAR GLOBAL mulFp6BLS12381_b3_y
VAR GLOBAL mulFp6BLS12381_c1_x
VAR GLOBAL mulFp6BLS12381_c1_y
VAR GLOBAL mulFp6BLS12381_c2_x
VAR GLOBAL mulFp6BLS12381_c2_y
VAR GLOBAL mulFp6BLS12381_c3_x
VAR GLOBAL mulFp6BLS12381_c3_y

VAR GLOBAL _a1b1mul_x
VAR GLOBAL _a1b1mul_y
VAR GLOBAL _a2b2mul_x
VAR GLOBAL _a2b2mul_y
VAR GLOBAL _a3b3mul_x
VAR GLOBAL _a3b3mul_y
VAR GLOBAL _a3b3ximul_x
VAR GLOBAL _a3b3ximul_y

VAR GLOBAL _a2a3sum_x
VAR GLOBAL _a2a3sum_y
VAR GLOBAL _b2b3sum_x
VAR GLOBAL _b2b3sum_y
VAR GLOBAL _a1a2sum_x
VAR GLOBAL _a1a2sum_y
VAR GLOBAL _b1b2sum_x
VAR GLOBAL _b1b2sum_y
VAR GLOBAL _a1a3sum_x
VAR GLOBAL _a1a3sum_y
VAR GLOBAL _b1b3sum_x
VAR GLOBAL _b1b3sum_y

VAR GLOBAL _RR

; RESOURCES:
; -----------------------------
; [steps: 190, bin: 0, arith: 23]
; -----------------------------

mulFp6BLS12381:
        RR => _RR

        ; 1] a1·b1, a2·b2, a3·b3, a3·b3·(1+u)
        mulFp6BLS12381_a1_x => A
        mulFp6BLS12381_a1_y => B
        mulFp6BLS12381_b1_x => C
        mulFp6BLS12381_b1_y => D        :CALL(mulFp2BLS12381)
        E => _a1b1mul_x
        C => _a1b1mul_y

        mulFp6BLS12381_a2_x => A
        mulFp6BLS12381_a2_y => B
        mulFp6BLS12381_b2_x => C
        mulFp6BLS12381_b2_y => D        :CALL(mulFp2BLS12381)
        E => _a2b2mul_x
        C => _a2b2mul_y

        mulFp6BLS12381_a3_x => A
        mulFp6BLS12381_a3_y => B
        mulFp6BLS12381_b3_x => C
        mulFp6BLS12381_b3_y => D        :CALL(mulFp2BLS12381)
        E => _a3b3mul_x
        C => _a3b3mul_y

        E => A
        C => B
        %BLS12_381_EXT_X => C
        %BLS12_381_EXT_Y => D            :CALL(mulFp2BLS12381)

        E => _a3b3ximul_x
        C => _a3b3ximul_y

        ; 2] a2+a3, b2+b3, a1+a2, b1+b2, a1+a3, b1+b3
        mulFp6BLS12381_a2_x => A
        mulFp6BLS12381_a2_y => B
        mulFp6BLS12381_a3_x => C
        mulFp6BLS12381_a3_y => D        :CALL(addFp2BLS12381)
        E => _a2a3sum_x
        C => _a2a3sum_y

        mulFp6BLS12381_b2_y => B
        mulFp6BLS12381_b2_x => A
        mulFp6BLS12381_b3_x => C
        mulFp6BLS12381_b3_y => D        :CALL(addFp2BLS12381)
        E => _b2b3sum_x
        C => _b2b3sum_y

        mulFp6BLS12381_a1_x => A
        mulFp6BLS12381_a1_y => B
        mulFp6BLS12381_a2_x => C
        mulFp6BLS12381_a2_y => D        :CALL(addFp2BLS12381)
        E => _a1a2sum_x
        C => _a1a2sum_y

        mulFp6BLS12381_b1_x => A
        mulFp6BLS12381_b1_y => B
        mulFp6BLS12381_b2_x => C
        mulFp6BLS12381_b2_y => D        :CALL(addFp2BLS12381)
        E => _b1b2sum_x
        C => _b1b2sum_y

        mulFp6BLS12381_a1_x => A
        mulFp6BLS12381_a1_y => B
        mulFp6BLS12381_a3_x => C
        mulFp6BLS12381_a3_y => D        :CALL(addFp2BLS12381)
        E => _a1a3sum_x
        C => _a1a3sum_y

        mulFp6BLS12381_b1_x => A
        mulFp6BLS12381_b1_y => B
        mulFp6BLS12381_b3_x => C
        mulFp6BLS12381_b3_y => D        :CALL(addFp2BLS12381)
        C => _b1b3sum_y
        E => _b1b3sum_x

        ; 3] c1 = [(a2+a3)·(b2+b3) - a2·b2 - a3·b3]·(1+u) + a1·b1
        _a2a3sum_x => A
        _a2a3sum_y => B
        _b2b3sum_x => C
        _b2b3sum_y => D                 :CALL(mulFp2BLS12381)

        E => A
        C => B
        _a2b2mul_x => C
        _a2b2mul_y => D                 :CALL(subFp2BLS12381)

        E => A
        C => B
        _a3b3mul_x => C
        _a3b3mul_y => D                 :CALL(subFp2BLS12381)

        E => A
        C => B
        %BLS12_381_EXT_X => C
        %BLS12_381_EXT_Y => D            :CALL(mulFp2BLS12381)

        E => A
        C => B
        _a1b1mul_x => C
        _a1b1mul_y => D                 :CALL(addFp2BLS12381)
        E => mulFp6BLS12381_c1_x
        C => mulFp6BLS12381_c1_y

        ; 4] c2 = (a1+a2)·(b1+b2) - a1·b1 - a2·b2 + (1+u)·(a3·b3)
        _a1a2sum_x => A
        _a1a2sum_y => B
        _b1b2sum_x => C
        _b1b2sum_y => D                 :CALL(mulFp2BLS12381)

        E => A
        C => B
        _a1b1mul_x => C
        _a1b1mul_y => D                 :CALL(subFp2BLS12381)

        E => A
        C => B
        _a2b2mul_x => C
        _a2b2mul_y => D                 :CALL(subFp2BLS12381)

        E => A
        C => B
        _a3b3ximul_x => C
        _a3b3ximul_y => D               :CALL(addFp2BLS12381)
        E => mulFp6BLS12381_c2_x
        C => mulFp6BLS12381_c2_y

        ; 5] c3 (a1+a3)·(b1+b3) - a1·b1 + a2·b2 - a3·b3
        _a1a3sum_x => A
        _a1a3sum_y => B
        _b1b3sum_x => C
        _b1b3sum_y => D                 :CALL(mulFp2BLS12381)

        E => A
        C => B
        _a1b1mul_x => C
        _a1b1mul_y => D                 :CALL(subFp2BLS12381)
        E => A
        C => B
        _a2b2mul_x => C
        _a2b2mul_y => D                 :CALL(addFp2BLS12381)
        E => A
        C => B
        _a3b3mul_x => C
        _a3b3mul_y => D                 :CALL(subFp2BLS12381)
        E => mulFp6BLS12381_c3_x
        C => mulFp6BLS12381_c3_y

        _RR => RR                       :RETURN
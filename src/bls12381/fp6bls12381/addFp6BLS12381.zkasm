;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P) because if falls back to FP2 arithmetic
;;
;; addFp6BLS12381:
;;             in: (a1 + a2·v + a3·v²),(b1 + b2·v + b3·v²) ∈ Fp6, where ai,bi ∈ Fp2
;;             out: (c1 + c2·v + c3·v²) = (a1+b1) + (a2+b2)·v + (a3+b3)·v² ∈ Fp6
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

VAR GLOBAL addFp6BLS12381_a1_x
VAR GLOBAL addFp6BLS12381_a1_y
VAR GLOBAL addFp6BLS12381_a2_x
VAR GLOBAL addFp6BLS12381_a2_y
VAR GLOBAL addFp6BLS12381_a3_x
VAR GLOBAL addFp6BLS12381_a3_y
VAR GLOBAL addFp6BLS12381_b1_x
VAR GLOBAL addFp6BLS12381_b1_y
VAR GLOBAL addFp6BLS12381_b2_x
VAR GLOBAL addFp6BLS12381_b2_y
VAR GLOBAL addFp6BLS12381_b3_x
VAR GLOBAL addFp6BLS12381_b3_y
VAR GLOBAL addFp6BLS12381_c1_x
VAR GLOBAL addFp6BLS12381_c1_y
VAR GLOBAL addFp6BLS12381_c2_x
VAR GLOBAL addFp6BLS12381_c2_y
VAR GLOBAL addFp6BLS12381_c3_x
VAR GLOBAL addFp6BLS12381_c3_y

VAR GLOBAL _RR

addFp6BLS12381:
        RR => _RR

        ; 1] c1 = a1+b1
        addFp6BLS12381_a1_x => A
        addFp6BLS12381_a1_y => B
        addFp6BLS12381_b1_x => C
        addFp6BLS12381_b1_y => D        :CALL(addFp2BLS12381)
        E => addFp6BLS12381_c1_x
        C => addFp6BLS12381_c1_y

        ; 2] c2 = a2+b2
        addFp6BLS12381_a2_x => A
        addFp6BLS12381_a2_y => B
        addFp6BLS12381_b2_x => C
        addFp6BLS12381_b2_y => D        :CALL(addFp2BLS12381)
        E => addFp6BLS12381_c2_x
        C => addFp6BLS12381_c2_y

        ; 3] c3 = a3+b3
        addFp6BLS12381_a3_x => A
        addFp6BLS12381_a3_y => B
        addFp6BLS12381_b3_x => C
        addFp6BLS12381_b3_y => D        :CALL(addFp2BLS12381)
        E => addFp6BLS12381_c3_x
        C => addFp6BLS12381_c3_y

        $ => RR                         :MLOAD(_RR), RETURN
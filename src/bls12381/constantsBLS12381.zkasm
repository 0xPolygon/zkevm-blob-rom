;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;;  Constants of the optimal Ate pairing over the BLS12381 curve
;;                      e: G1 x G2 --> GT
;;  where G1 = E(Fp)[r], G2 = E'(Fp2)[r] and GT = μ_r (the group of r-th roots of unity over Fp12*) over the curves:
;;              E/Fp: y² = x³ + 4,    E'/Fp2: y'² = x'³ + 4·(1+u)
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Basic constants:
;       · X = -15132376222941642752        = "BLS family parameter",
;       · P = 1/3*(X-1)**2*(X**4-X**2+1)+X = "base field order",
;       · R = X**4-X**2+1                  = "scalar field order"
; CONSTL %BLS12381_X = -0xd201000000010000n
CONSTL %BLS12381_P = 0x1a0111ea397fe69a4b1ba7b6434bacd764774b84f38512bf6730d2a0f6b0f6241eabfffeb153ffffb9feffffffffaaabn
CONSTL %BLS12381_P_MINUS_ONE = %BLS12381_P - 1n
CONSTL %BLS12381_R = 0x73eda753299d7d483339d80809a1d80553bda402fffe5bfeffffffff00000001n ; It is satisfied that 2·r < 2²⁵⁶ < 3·r
CONSTL %BLS12_381_R_MINUS_ONE = %BLS12381_R - 1n
CONSTL %BLS12_381_R_4096_inv = 0x73e66878b46ae3705eb6a46a89213de7d3686828bfce5c19400fffff00100001n

; Encodes 1 + u, where u is s.t. u² = - 1
CONST %BLS12381_EXT_X = 1
CONST %BLS12381_EXT_Y = 1

; Coordinates of the generator of the group G1
CONSTL %BLS12_381_G1X = 0x17f1d3a73197d7942695638c4fa9ac0fc3688c4f9774b905a14e3a3f171bac586c55e83ff97a1aeffb3af00adb22c6bbn
CONSTL %BLS12_381_G1Y = 0x8b3f481e3aaa0f1a09e30ed741d8ae4fcf5e095d5d00af600db18cb2c04b3edd03cc744a2888ae40caa232946c5e7e1n

; Coordinates of the generator of the group G2
CONSTL %BLS12_381_G2X1 = 0x24aa2b2f08f0a91260805272dc51051c6e47ad4fa403b02b4510b647ae3d1770bac0326a805bbefd48056c8c121bdb8n
CONSTL %BLS12_381_G2Y1 = 0x13e02b6052719f607dacd3a088274f65596bd0d09920b61ab5da61bbdc7f5049334cf11213945d57e5ac7d055d042b7en
CONSTL %BLS12_381_G2X2 = 0xce5d527727d6e118cc9cdc6da2e351aadfd9baa8cbdd3a76d429a695160d12c923ac9cc3baca289e193548608b82801n
CONSTL %BLS12_381_G2Y2 = 0x606c4a02ea734cc32acd2b02bc28b99cb3e287e85a763af267492ab572e99ab3f370d275cec1da1aaa9075ff05f79ben

; Precomputed frobenius operator constants. These are used to compute f^p and f^p2 efficiently, where f ∈ Fp12
; See: https://hackmd.io/4gg0L936QsGdvSwZOjonlQ?view#Frobenius-Operator
CONSTL %FROBENIUS_GAMMA11X = 0x1904d3bf02bb0667c231beb4202c0d1f0fd603fd3cbd5f4f7b2443d784bab9c4f67ea53d63e7813d8d0775ed92235fb8n
CONSTL %FROBENIUS_GAMMA11Y = 0xfc3e2b36c4e03288e9e902231f9fb854a14787b6c7b36fec0c8ec971f63c5f282d5ac14d6c7ec22cf78a126ddc4af3n
CONSTL %FROBENIUS_GAMMA12X = 0x0n
CONSTL %FROBENIUS_GAMMA12Y = 0x1a0111ea397fe699ec02408663d4de85aa0d857d89759ad4897d29650fb85f9b409427eb4f49fffd8bfd00000000aaacn
CONSTL %FROBENIUS_GAMMA13X = 0x6af0e0437ff400b6831e36d6bd17ffe48395dabc2d3435e77f76e17009241c5ee67992f72ec05f4c81084fbede3cc09n
CONSTL %FROBENIUS_GAMMA13Y = 0x6af0e0437ff400b6831e36d6bd17ffe48395dabc2d3435e77f76e17009241c5ee67992f72ec05f4c81084fbede3cc09n
CONSTL %FROBENIUS_GAMMA14 = 0x1a0111ea397fe699ec02408663d4de85aa0d857d89759ad4897d29650fb85f9b409427eb4f49fffd8bfd00000000aaadn
CONSTL %FROBENIUS_GAMMA15X = 0x5b2cfd9013a5fd8df47fa6b48b1e045f39816240c0b8fee8beadf4d8e9c0566c63a3e6e257f87329b18fae980078116n
CONSTL %FROBENIUS_GAMMA15Y = 0x144e4211384586c16bd3ad4afa99cc9170df3560e77982d0db45f3536814f0bd5871c1908bd478cd1ee605167ff82995n
CONSTL %FROBENIUS_GAMMA21 = 0x5f19672fdf76ce51ba69c6076a0f77eaddb3a93be6f89688de17d813620a00022e01fffffffeffffn
CONSTL %FROBENIUS_GAMMA22 = 0x5f19672fdf76ce51ba69c6076a0f77eaddb3a93be6f89688de17d813620a00022e01fffffffefffen
CONSTL %FROBENIUS_GAMMA23 = 0x1a0111ea397fe69a4b1ba7b6434bacd764774b84f38512bf6730d2a0f6b0f6241eabfffeb153ffffb9feffffffffaaaan
CONSTL %FROBENIUS_GAMMA24 = 0x1a0111ea397fe699ec02408663d4de85aa0d857d89759ad4897d29650fb85f9b409427eb4f49fffd8bfd00000000aaacn
CONSTL %FROBENIUS_GAMMA25 = 0x1a0111ea397fe699ec02408663d4de85aa0d857d89759ad4897d29650fb85f9b409427eb4f49fffd8bfd00000000aaadn



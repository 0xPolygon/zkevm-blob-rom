_equation_is_not_satisfied:
        ; the pairing equation is not satisfied, then output 0
        0 => A,B 					        :JMP(_end)

_equation_is_satisfied:
        ; the pairing equation is satisfied, then output 1
        1 => A
	0 => B						        :JMP(_end)


; ERRORS
; =================
_commit_too_large:
        1 => B                                		        :JMP(_error)

_invalid_commit_serialization:
        2 => B                                		        :JMP(_error)

_invalid_lhs:
        3 => B                                		        :JMP(_error)

_proof_too_large:
    	4 => B                                		        :JMP(_error)

_invalid_proof_serialization:
    	5 => B                                		        :JMP(_error)

_invalid_rhs:
    	6 => B                                		        :JMP(_error)

_y_too_large:
    	7 => B                                		        :JMP(_error)

_z_too_large:
    	8 => B                                		        :JMP(_error)
; =================

_error:
	0 => A                                                  :JMP(_end)

_end:
        _RR => RR         				        :RETURN
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Verification of KZG opening proofs
;;
;; KZGVerify:
;;         input: commit ∈ G1, z ∈ Fr, y ∈ Fr, proof ∈ G1
;;         output:
;;              · A = 1, if e(commit - [y]₁, [1]₂) = e(proof, [x]₂ - [z]₂), where [x]₂ is given in the SRS
;;              · A = 0, otherwise -> B = 1 if there is an input error, B = 0 otherwise
;;
;; Note1: [a]₁ is a standarized shortand used to indicate a·G₁, where G₁ is the generator of the group G1
;;        [a]₂ is a standarized shortand used to indicate a·G₂, where G₂ is the generator of the group G2
;; Note2: We check e(commit - [y]₁, [1]₂)·e(-proof, [x]₂ - [z]₂) = 1 instead to perform the check with a single final exponentiation
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

VAR GLOBAL KZGVerify_commit_low ; This is given as the serialization of a point in E (32 bytes in low + 16 bytes in high = 48 bytes)
VAR GLOBAL KZGVerify_commit_high
VAR GLOBAL KZGVerify_z          ; This is the challenging opening (32 bytes)
VAR GLOBAL KZGVerify_y          ; This is, presumably, the evaluation at z of the polynomial hidden under the commitment (32 bytes)
VAR GLOBAL KZGVerify_proof_low  ; This is given as the serialization of a point in E (32 bytes in low + 16 bytes in high = 48 bytes)
VAR GLOBAL KZGVerify_proof_high

VAR GLOBAL _commit_x
VAR GLOBAL _commit_y
VAR GLOBAL _proof_x
VAR GLOBAL _proof_y

VAR GLOBAL _P_x
VAR GLOBAL _P_y
VAR GLOBAL _Q_x1
VAR GLOBAL _Q_x2
VAR GLOBAL _Q_y1
VAR GLOBAL _Q_y2

VAR GLOBAL _RR

KZGVerify:
	RR => _RR

	; 1] Reconstruct and deserialize commit and proof
        KZGVerify_commit_low => A     			:MODE_256_BITS
        KZGVerify_commit_high => B     			:MODE_256_BITS
        $ => A     					:ARITH_256TO384, CALL(deserializationFpBLS12381) ; in: [A] out: [A,B,C]
	A => _commit_x
	B => _commit_y

        KZGVerify_proof_low => A     			:MODE_256_BITS
        KZGVerify_proof_high => B     			:MODE_256_BITS
        $ => A     					:ARITH_256TO384, CALL(deserializationFpBLS12381) ; in: [A] out: [A,B,C]
	A => _proof_x
	B => _proof_y

        ; 2] Compute commit - [y]₁
	;    2.1] [y]₁
	KZGVerify_y => A
	A => scalarMulPointFpBLS12381_s
	%BLS12_381_G1X => scalarMulPointFpBLS12381_P_x
	%BLS12_381_G1Y => scalarMulPointFpBLS12381_P_y	:CALL(scalarMulPointFpBLS12381) ; in: [s,P_x,P_y] out: [Q_x,Q_y]

	;    2.2] commit - [y]₁
	_commit_x => A
	_commit_y => B
	A => addPointFpBLS12381_P1_x
	B => addPointFpBLS12381_P1_y
	scalarMulPointFpBLS12381_Q_y => A 		:CALL(negFpBLS12381) ; in: [A] out: [B]
	scalarMulPointFpBLS12381_Q_x => A
	A => addPointFpBLS12381_P2_x
	B => addPointFpBLS12381_P2_y			:CALL(addPointFpBLS12381) ; in: [P1_x,P1_y,P2_x,P2_y] out: [P3_x,P3_y]

	; 3] compute Miller_loop(commit - [y]₁, [1]₂)
        addPointFpBLS12381_P3_x => A
	addPointFpBLS12381_P3_y => B
        A => halfPairingBLS12381_P_x
        B => halfPairingBLS12381_P_y
	%BLS12_381_G2X1 => halfPairingBLS12381_Q_x1
	%BLS12_381_G2X2 => halfPairingBLS12381_Q_x2
	%BLS12_381_G2Y1 => halfPairingBLS12381_Q_y1
	%BLS12_381_G2Y2 => halfPairingBLS12381_Q_y2	:CALL(halfPairingBLS12381) ; in: [P_x,P_y,Q_x1,Q_x2,Q_y1,Q_y2]
									           ;out: [out11_x,out11_y,out12_x,out12_y,out13_x,out13_y,out21_x,out21_y,out22_x,out22_y,out23_x,out23_y]

	; Check if error
	B  						:JMPNZ(_input_error)

	; input it to multiplication
	halfPairingBLS12381_out11_x => A
	halfPairingBLS12381_out11_y => B
	A => mulFp12BLS12381_a11_x
	B => mulFp12BLS12381_a11_y
	halfPairingBLS12381_out12_x => A
	halfPairingBLS12381_out12_y => B
	A => mulFp12BLS12381_a12_x
	B => mulFp12BLS12381_a12_y
	halfPairingBLS12381_out13_x => A
	halfPairingBLS12381_out13_y => B
	A => mulFp12BLS12381_a13_x
	B => mulFp12BLS12381_a13_y
	halfPairingBLS12381_out21_x => A
	halfPairingBLS12381_out21_y => B
	A => mulFp12BLS12381_a21_x
	B => mulFp12BLS12381_a21_y
	halfPairingBLS12381_out22_x => A
	halfPairingBLS12381_out22_y => B
	A => mulFp12BLS12381_a22_x
	B => mulFp12BLS12381_a22_y
	halfPairingBLS12381_out23_x => A
	halfPairingBLS12381_out23_y => B
	A => mulFp12BLS12381_a23_x
	B => mulFp12BLS12381_a23_y

        ; 4] Compute [x]₂ - [z]₂
	;    4.1] [z]₂
	KZGVerify_z => A
	A => scalarMulPointFp2BLS12381_s
	%BLS12_381_G2X1 => scalarMulPointFp2BLS12381_P_x1
	%BLS12_381_G2X2 => scalarMulPointFp2BLS12381_P_x2
	%BLS12_381_G2Y1 => scalarMulPointFp2BLS12381_P_y1
	%BLS12_381_G2Y2 => scalarMulPointFp2BLS12381_P_y2	:CALL(scalarMulPointFp2BLS12381)

	;    4.2] [x]₂ - [z]₂
	%BLS12_381_X_X1 => A
	%BLS12_381_X_X2 => B
	A => addPointFp2BLS12381_P1_x1
	B => addPointFp2BLS12381_P1_x2
	%BLS12_381_X_Y1 => A
	%BLS12_381_X_Y2 => B
	A => addPointFp2BLS12381_P1_y1
	B => addPointFp2BLS12381_P1_y2
	scalarMulPointFp2BLS12381_Q_x1 => A
	scalarMulPointFp2BLS12381_Q_x2 => B
	A => addPointFp2BLS12381_P2_x1
	B => addPointFp2BLS12381_P2_x2
	scalarMulPointFp2BLS12381_Q_y1 => C
	scalarMulPointFp2BLS12381_Q_y2 => D		:CALL(negFp2BLS12381) ; in: [C,D] out: [E,C]
	E => addPointFp2BLS12381_P2_y1
	C => addPointFp2BLS12381_P2_y2			:CALL(addPointFp2BLS12381)

	; 5] Compute Miller_loop(-proof, [x]₂ - [z]₂)
        _proof_y => A 					:CALL(negFpBLS12381) ; in: [A] out: [B]
        _proof_x => A
        A => halfPairingBLS12381_P_x
        B => halfPairingBLS12381_P_y
	addPointFp2BLS12381_P3_x1 => A
	addPointFp2BLS12381_P3_x2 => B
	A => halfPairingBLS12381_Q_x1
	B => halfPairingBLS12381_Q_x2
	addPointFp2BLS12381_P3_y1 => A
	addPointFp2BLS12381_P3_y2 => B
	A => halfPairingBLS12381_Q_y1
	B => halfPairingBLS12381_Q_y2			:CALL(halfPairingBLS12381)

	; Check if error
	B  						:JMPNZ(_input_error)

	; input it to multiplication
	halfPairingBLS12381_out11_x => A
	halfPairingBLS12381_out11_y => B
	A => mulFp12BLS12381_b11_x
	B => mulFp12BLS12381_b11_y
	halfPairingBLS12381_out12_x => A
	halfPairingBLS12381_out12_y => B
	A => mulFp12BLS12381_b12_x
	B => mulFp12BLS12381_b12_y
	halfPairingBLS12381_out13_x => A
	halfPairingBLS12381_out13_y => B
	A => mulFp12BLS12381_b13_x
	B => mulFp12BLS12381_b13_y
	halfPairingBLS12381_out21_x => A
	halfPairingBLS12381_out21_y => B
	A => mulFp12BLS12381_b21_x
	B => mulFp12BLS12381_b21_y
	halfPairingBLS12381_out22_x => A
	halfPairingBLS12381_out22_y => B
	A => mulFp12BLS12381_b22_x
	B => mulFp12BLS12381_b22_y
	halfPairingBLS12381_out23_x => A
	halfPairingBLS12381_out23_y => B
	A => mulFp12BLS12381_b23_x
	B => mulFp12BLS12381_b23_y			:CALL(mulFp12BLS12381)

	; 6] Finish the pairing by computing the final exponentiation
        mulFp12BLS12381_c11_x => A
        mulFp12BLS12381_c11_y => B
        A => finalExpBLS12381_f11_x
        B => finalExpBLS12381_f11_y
        mulFp12BLS12381_c12_x => A
        mulFp12BLS12381_c12_y => B
        A => finalExpBLS12381_f12_x
        B => finalExpBLS12381_f12_y
        mulFp12BLS12381_c13_x => A
        mulFp12BLS12381_c13_y => B
        A => finalExpBLS12381_f13_x
        B => finalExpBLS12381_f13_y
        mulFp12BLS12381_c21_x => A
        mulFp12BLS12381_c21_y => B
        A => finalExpBLS12381_f21_x
        B => finalExpBLS12381_f21_y
        mulFp12BLS12381_c22_x => A
        mulFp12BLS12381_c22_y => B
        A => finalExpBLS12381_f22_x
        B => finalExpBLS12381_f22_y
        mulFp12BLS12381_c23_x => A
        mulFp12BLS12381_c23_y => B
        A => finalExpBLS12381_f23_x
        B => finalExpBLS12381_f23_y			:CALL(finalExpBLS12381)

        ; Check whether the result is equal 1 or not
    	finalExpBLS12381_f11_x - 1 => C             	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)

    	finalExpBLS12381_f11_y => C            		:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)

    	finalExpBLS12381_f12_x => C            		:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)

    	finalExpBLS12381_f12_y => C            		:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)

    	finalExpBLS12381_f13_x => C            		:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)

    	finalExpBLS12381_f13_y => C            		:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)

    	finalExpBLS12381_f21_x => C            		:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)

    	finalExpBLS12381_f21_y => C            		:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)

    	finalExpBLS12381_f22_x => C            		:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)

    	finalExpBLS12381_f22_y => C            		:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)

    	finalExpBLS12381_f23_x => C            		:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)

    	finalExpBLS12381_f23_y => C            		:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied)
    	ROTL_C => C                                 	:JMPNZ(_equation_is_not_satisfied, _equation_is_satisfied)

_equation_is_not_satisfied:
        ; the pairing equation is not satisfied, then output 0
        0 => A 						:JMP(_no_input_error)

_equation_is_satisfied:
        ; the pairing equation is satisfied, then output 1
        1 => A 						:JMP(_no_input_error)

; ERRORS
_input_error:
        1 => B          				:JMP(_error)

_no_input_error:
        0 => B          				:JMP(_end)

_error:
        0 => A

_end:
        _RR => RR         				:RETURN
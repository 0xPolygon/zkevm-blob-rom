;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: ARITH_BLS12381_ADDFP2 ensures that the result is in the range [0,BLS12_381_P)
;;
;; addFp2BLS12381:
;;             in: (A + B·u), (C + D·u) ∈ Fp2, where A,B,C,D ∈ Fp
;;             out: E + C·u = (A + C) + (B + D)·u ∈ Fp2
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

; RESOURCES:
; -----------------------------
; [steps: 2, bin: 0, arith: 1]
; -----------------------------

addFp2BLS12381:
        ; Compute and check the mul
        ; A + C = [E] + (q0·BLS12381_P)
        ; B + D = [OP] + (q1·BLS12381_P)
        ${ARITH_BLS12381_ADDFP2(A,C)} => E
        ${ARITH_BLS12381_ADDFP2(B,D)} => C              :ARITH_BLS12381_ADDFP2, RETURN
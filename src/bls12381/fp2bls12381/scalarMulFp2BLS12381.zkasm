;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: ARITH_BLS12381_MULFP2 ensures that the result is in the range [0,BLS12381_P)
;;
;; scalarMulFp2BLS12381:
;;             in: A ∈ Fp, (C + D·u) ∈ Fp2, where C,D ∈ Fp
;;             out: E + C·u = (A·C) + (A·D)·u ∈ Fp2
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; RESOURCES:
; -----------------------------
; [steps: 3, bin: 0, arith: 1]
; -----------------------------

scalarMulFp2BLS12381:
        ; Compute and check the mul
        ; A·C - 0·D = [E] + (q0·BLS12381_P)
        ; A·D + 0·C = [OP] + (q1·BLS12381_P)
        0 => B
        ${ARITH_BLS12381_MULFP2_X(A,B,C,D)} => E
        ${ARITH_BLS12381_MULFP2_Y(A,B,C,D)} => C        :ARITH_BLS12381_MULFP2, RETURN
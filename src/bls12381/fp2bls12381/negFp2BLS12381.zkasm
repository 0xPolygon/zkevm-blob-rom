;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: The result is in the range [0,BLS12_381_P)
;;
;; negFp2BLS12381:
;;             in: (C + D·u) ∈ Fp2, where C,D ∈ Fp
;;             out: E + C·u = -C - D·u ∈ Fp2
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

; RESOURCES:
; -----------------------------
; [steps: 3, bin: 0, arith: 1]
; -----------------------------

negFp2BLS12381:
        ; Compute and check the mul
        ; 0 - C = [E] + (q0·BLS12381_P)
        ; 0 - D = [OP] + (q1·BLS12381_P)
        0 => A,B
        ${ARITH_BLS12381_SUBFP2(0,C)} => E
        ${ARITH_BLS12381_SUBFP2(0,D)} => C              :ARITH_BLS12381_SUBFP2, RETURN
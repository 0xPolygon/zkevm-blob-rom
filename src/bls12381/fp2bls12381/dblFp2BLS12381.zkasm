;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: ARITH_BLS12381_ADDFP2 ensures that the result is in the range [0,BLS12_381_P)
;;
;; dblFp2BLS12381:
;;             in: (A + B·u) ∈ Fp2, where A,B ∈ Fp
;;             out: E + C·u = (A + A) + (B + B)·u ∈ Fp2
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

dblFp2BLS12381:
        ; Compute and check the mul
        ; A + A = [E] + (q0·BLS12381_P)
        ; B + B = [OP] + (q1·BLS12381_P)
        A => C
        B => D
        ${ARITH_BLS12381_ADDFP2(A,A)} => E
        ${ARITH_BLS12381_ADDFP2(B,B)} => C              :ARITH_BLS12381_ADDFP2, RETURN
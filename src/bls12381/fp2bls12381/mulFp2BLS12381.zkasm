;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; POST: ARITH_BLS12381_MULFP2 ensures that the result is in the range [0,BLS12_381_P)
;;
;; mulFp2BLS12381:
;;             in: (A + B·u), (C + D·u) ∈ Fp2, where A,B,C,D ∈ Fp
;;             out: E + C·u = (A·C - B·D) + (A·D + B·C)·u ∈ Fp2
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

PRAGMA MODE_384_BITS

; RESOURCES:
; -----------------------------
; [steps: 2, bin: 0, arith: 1]
; -----------------------------

mulFp2BLS12381:
        ; Compute and check the mul
        ; A·C - B·D = [E] + (q0·BLS12381_P)
        ; A·D + B·C = [OP] + (q1·BLS12381_P)
        ${ARITH_BLS12381_MULFP2_X(A,B,C,D)} => E
        ${ARITH_BLS12381_MULFP2_Y(A,B,C,D)} => C        :ARITH_BLS12381_MULFP2, RETURN
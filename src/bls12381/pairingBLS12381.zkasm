;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Optimal Ate Pairing e: G1 x G2 -> GT over the BLS12381 curve
;;  where G1 = E(Fp)[r], G2 = E'(Fp2)[r] and GT = μ_r (the group of r-th roots of unity over Fp12*) over the curves:
;;              E/Fp: y² = x³ + 4,    E'/Fp2: y'² = x'³ + 4·(1+u)
;;
;;  pairingBLS12381:
;;          input: P ∈ G1 and Q ∈ G2
;;          output: e(P,Q) := conjugate(f_{|x|,Q}(P))^{(p¹²-1)/r} ∈ GT
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

VAR GLOBAL pairingBLS12381_P_x
VAR GLOBAL pairingBLS12381_P_y
VAR GLOBAL pairingBLS12381_Q_x1
VAR GLOBAL pairingBLS12381_Q_x2
VAR GLOBAL pairingBLS12381_Q_y1
VAR GLOBAL pairingBLS12381_Q_y2

VAR GLOBAL pairingBLS12381_out11_x
VAR GLOBAL pairingBLS12381_out11_y
VAR GLOBAL pairingBLS12381_out12_x
VAR GLOBAL pairingBLS12381_out12_y
VAR GLOBAL pairingBLS12381_out13_x
VAR GLOBAL pairingBLS12381_out13_y
VAR GLOBAL pairingBLS12381_out21_x
VAR GLOBAL pairingBLS12381_out21_y
VAR GLOBAL pairingBLS12381_out22_x
VAR GLOBAL pairingBLS12381_out22_y
VAR GLOBAL pairingBLS12381_out23_x
VAR GLOBAL pairingBLS12381_out23_y

VAR GLOBAL _P_is_zero
VAR GLOBAL _Q_is_zero
VAR GLOBAL _P_and_Q_are_zero

VAR GLOBAL _RR

; ERROR CODES (B)
; 0 - no error
; 1 - P_x is too big
; 2 - P_y is too big
; 3 - Q_x1 is too big
; 4 - Q_x2 is too big
; 5 - Q_y1 is too big
; 6 - Q_y2 is too big
; 7 - P is not in E
; 8 - P is not in G1
; 9 - Q is not in tE
; 10 - Q is not in G2

; RESOURCES (not considering error paths):
; -------------------------------------------
; PATH 1 P == 𝒪 and Q == 𝒪:     [steps: 40,  bin: 12, arith: 0]
; PATH 2 P == 𝒪 and Q != 𝒪:     [steps: 20939, bin: 561, arith: 1804]
; PATH 3 P != 𝒪 and Q == 𝒪:     [steps: 96,  bin: 17, arith: 8]
; PATH 4 P,Q != 𝒪:              [steps: 342758, bin: 1452, arith: 28738] <--- w.c.
; -------------------------------------------

pairingBLS12381:
    RR => _RR

    ; Let's check whether some P coordinate are too big
    0 => A
    %BLS12381_P => D

    pairingBLS12381_P_x => B,C
    ; 0·B + C = op (mod BLS12381_P)
    ${C % D} => C                               :ARITH_MOD
    B - C => C                                  :JMPNZ(_Px_too_big)
    ROTL_C => C                                 :JMPNZ(_Px_too_big)
    ROTL_C => C                                 :JMPNZ(_Px_too_big)
    ROTL_C => C                                 :JMPNZ(_Px_too_big)
    ROTL_C => C                                 :JMPNZ(_Px_too_big)
    ROTL_C => C                                 :JMPNZ(_Px_too_big)
    ROTL_C => C                                 :JMPNZ(_Px_too_big)
    ROTL_C => C                                 :JMPNZ(_Px_too_big)

    pairingBLS12381_P_y => B,C
    ; 0·B + C = op (mod BLS12381_P)
    ${C % D} => C                               :ARITH_MOD
    B - C => C                                  :JMPNZ(_Py_too_big)
    ROTL_C => C                                 :JMPNZ(_Py_too_big)
    ROTL_C => C                                 :JMPNZ(_Py_too_big)
    ROTL_C => C                                 :JMPNZ(_Py_too_big)
    ROTL_C => C                                 :JMPNZ(_Py_too_big)
    ROTL_C => C                                 :JMPNZ(_Py_too_big)
    ROTL_C => C                                 :JMPNZ(_Py_too_big)
    ROTL_C => C                                 :JMPNZ(_Py_too_big)

    ; Let's check whether some Q coordinate are too big
    pairingBLS12381_Q_x1 => B,C
    ; 0·B + C = op (mod BLS12381_P)
    ${C % D} => C                               :ARITH_MOD
    B - C => C                                  :JMPNZ(_Qx1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx1_too_big)


    pairingBLS12381_Q_x2 => B,C
    ; 0·B + C = op (mod BLS12381_P)
    ${C % D} => C                               :ARITH_MOD
    B - C => C                                  :JMPNZ(_Qx2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qx2_too_big)

    pairingBLS12381_Q_y1 => B,C
    ; 0·B + C = op (mod BLS12381_P)
    ${C % D} => C                               :ARITH_MOD
    B - C => C                                  :JMPNZ(_Qy1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy1_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy1_too_big)

    pairingBLS12381_Q_y2 => B,C
    ; 0·B + C = op (mod BLS12381_P)
    ${C % D} => C                               :ARITH_MOD
    B - C => C                                  :JMPNZ(_Qy2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy2_too_big)
    ROTL_C => C                                 :JMPNZ(_Qy2_too_big)

    ; Reset the zero variables
    0 => _P_is_zero
    0 => _Q_is_zero
    0 => _P_and_Q_are_zero

    ; Is P = 𝒪?
    pairingBLS12381_P_x => C                    :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)
    pairingBLS12381_P_y => C                    :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)
    ROTL_C => C                                 :JMPNZ(_continue_to_Q)

    ; If got here, mark P as zero
    1 => _P_is_zero

_continue_to_Q:

    ; Is Q = 𝒪?
    pairingBLS12381_Q_x1 => C                   :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    pairingBLS12381_Q_x2 => C                   :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    pairingBLS12381_Q_y1 => C                   :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    pairingBLS12381_Q_y2 => C                   :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)
    ROTL_C => C                                 :JMPNZ(_continue_to_checks)

    ; If got here, mark Q as zero
    1 => _Q_is_zero

_continue_to_checks:

    _P_is_zero                                  :JMPNZ(_continue_P_is_zero)
    _Q_is_zero                                  :JMPNZ(_continue_Q_is_zero)

    ; P,Q != 𝒪
                                                :JMP(_P_subgroup_check)

; Begin of branching
_continue_P_is_zero:
    ; before (w.c.) -> [steps: 19, bin: 8, arith: 0]

    _Q_is_zero                                  :JMPNZ(_result_is_one)

    ; Check that Q ∈ G2
    pairingBLS12381_Q_x1 => A
    pairingBLS12381_Q_x2 => B
    A => subCheckG2BLS12381_Q_x1
    B => subCheckG2BLS12381_Q_x2
    pairingBLS12381_Q_y1 => A
    pairingBLS12381_Q_y2 => B
    A => subCheckG2BLS12381_Q_y1
    B => subCheckG2BLS12381_Q_y2                 :CALL(subCheckG2BLS12381) ; A = 1, if Q ∈ G2
                                                                           ; A = 0, otherwise -> B = 0, if Q is not in tE
                                                                           ;                     B = 1, if Q is not in G2

    A                                           :JMPNZ(_result_is_one)
    B                                           :JMPZ(_Q_is_not_in_tE, _Q_is_not_in_G2)

_continue_Q_is_zero:
    ; before (w.c.) -> [steps: 28, bin: 12, arith: 0]

    ; Check that P ∈ G1
    pairingBLS12381_P_x => A
    pairingBLS12381_P_y => B
    A => subCheckG1BLS12381_P_x
    B => subCheckG1BLS12381_P_y                 :CALL(subCheckG1BLS12381) ; A = 1, if P ∈ G1
                                                                          ; A = 0, otherwise -> B = 0, if P is not in E
                                                                          ;                     B = 1, if P is not in G1

    A                                           :JMPNZ(_result_is_one)
    B                                           :JMPZ(_P_is_not_in_E, _P_is_not_in_G1)

_result_is_one:
    ; before (w.c.) -> [steps: 27, bin: 12, arith: 0]

    ; e(𝒪,Q) = e(P,𝒪) = e(𝒪,𝒪) = 1
    1 => pairingBLS12381_out11_x
    0 => pairingBLS12381_out11_y
    0 => pairingBLS12381_out12_x
    0 => pairingBLS12381_out12_y
    0 => pairingBLS12381_out13_x
    0 => pairingBLS12381_out13_y
    0 => pairingBLS12381_out21_x
    0 => pairingBLS12381_out21_y
    0 => pairingBLS12381_out22_x
    0 => pairingBLS12381_out22_y
    0 => pairingBLS12381_out23_x
    0 => pairingBLS12381_out23_y

    0 => B                                      :JMP(_end)

    ; till the end -> [steps: 40, bin: 12, arith: 0]
; End of branching

_P_subgroup_check:
    ; before (w.c.) -> [steps: 28, bin: 12, arith: 0]

    ; Check that P ∈ G1
    pairingBLS12381_P_x => A
    pairingBLS12381_P_y => B
    A => subCheckG1BLS12381_P_x
    B => subCheckG1BLS12381_P_y                 :CALL(subCheckG1BLS12381) ; A = 1, if P ∈ G1
                                                                          ; A = 0, otherwise -> B = 0, if P is not in E
                                                                          ;                     B = 1, if P is not in G1

    A                                           :JMPNZ(_Q_subgroup_check)
    B                                           :JMPZ(_P_is_not_in_E, _P_is_not_in_G1)

_Q_subgroup_check:
    ; Check that Q ∈ G2
    pairingBLS12381_Q_x1 => A
    pairingBLS12381_Q_x2 => B
    A => subCheckG2BLS12381_Q_x1
    B => subCheckG2BLS12381_Q_x2
    pairingBLS12381_Q_y1 => A
    pairingBLS12381_Q_y2 => B
    A => subCheckG2BLS12381_Q_y1
    B => subCheckG2BLS12381_Q_y2                 :CALL(subCheckG2BLS12381) ; A = 1, if Q ∈ G2
                                                                           ; A = 0, otherwise -> B = 0, if Q is not in tE
                                                                           ;                     B = 1, if Q is not in G2

    A                                           :JMPNZ(_Miller_loop)
    B                                           :JMPZ(_Q_is_not_in_tE, _Q_is_not_in_G2)

_Miller_loop:
    pairingBLS12381_P_x => A
    pairingBLS12381_P_y => B
    A => millerLoopBLS12381_P_x
    B => millerLoopBLS12381_P_y
    pairingBLS12381_Q_x1 => A
    pairingBLS12381_Q_x2 => B
    pairingBLS12381_Q_y1 => C
    pairingBLS12381_Q_y2 => D
    A => millerLoopBLS12381_Q_x1
    B => millerLoopBLS12381_Q_x2
    C => millerLoopBLS12381_Q_y1
    D => millerLoopBLS12381_Q_y2                :CALL(millerLoopBLS12381)

_final_exponentiation:
    millerLoopBLS12381_f11_x => A
    millerLoopBLS12381_f11_y => B
    A => finalExpBLS12381_f11_x
    B => finalExpBLS12381_f11_y
    millerLoopBLS12381_f12_x => A
    millerLoopBLS12381_f12_y => B
    A => finalExpBLS12381_f12_x
    B => finalExpBLS12381_f12_y
    millerLoopBLS12381_f13_x => A
    millerLoopBLS12381_f13_y => B
    A => finalExpBLS12381_f13_x
    B => finalExpBLS12381_f13_y
    millerLoopBLS12381_f21_x => A
    millerLoopBLS12381_f21_y => B
    A => finalExpBLS12381_f21_x
    B => finalExpBLS12381_f21_y
    millerLoopBLS12381_f22_x => A
    millerLoopBLS12381_f22_y => B
    A => finalExpBLS12381_f22_x
    B => finalExpBLS12381_f22_y
    millerLoopBLS12381_f23_x => A
    millerLoopBLS12381_f23_y => B
    A => finalExpBLS12381_f23_x
    B => finalExpBLS12381_f23_y                 :CALL(finalExpBLS12381)

    finalExpBLS12381_f11_x => A
    finalExpBLS12381_f11_y => B
    A => pairingBLS12381_out11_x
    B => pairingBLS12381_out11_y
    finalExpBLS12381_f12_x => A
    finalExpBLS12381_f12_y => B
    A => pairingBLS12381_out12_x
    B => pairingBLS12381_out12_y
    finalExpBLS12381_f13_x => A
    finalExpBLS12381_f13_y => B
    A => pairingBLS12381_out13_x
    B => pairingBLS12381_out13_y
    finalExpBLS12381_f21_x => A
    finalExpBLS12381_f21_y => B
    A => pairingBLS12381_out21_x
    B => pairingBLS12381_out21_y
    finalExpBLS12381_f22_x => A
    finalExpBLS12381_f22_y => B
    A => pairingBLS12381_out22_x
    B => pairingBLS12381_out22_y
    finalExpBLS12381_f23_x => A
    finalExpBLS12381_f23_y => B
    A => pairingBLS12381_out23_x
    B => pairingBLS12381_out23_y

    0 => B                                      :JMP(_end)

; ERRORS
_Px_too_big:
    1 => B                                      :JMP(_end)

_Py_too_big:
    2 => B                                      :JMP(_end)

_Qx1_too_big:
    3 => B                                      :JMP(_end)

_Qx2_too_big:
    4 => B                                      :JMP(_end)

_Qy1_too_big:
    5 => B                                      :JMP(_end)

_Qy2_too_big:
    6 => B                                      :JMP(_end)

_P_is_not_in_E:
    7 => B                                      :JMP(_end)

_P_is_not_in_G1:
    8 => B                                      :JMP(_end)

_Q_is_not_in_tE:
    9 => B                                      :JMP(_end)

_Q_is_not_in_G2:
    10 => B                                     :JMP(_end)

_end:
    _RR => RR                                   :RETURN
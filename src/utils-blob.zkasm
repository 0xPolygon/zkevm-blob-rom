; @info Get D bytes from HASHK with %INDEX_BLOB_L2_HASH_K_DATA (with HASHPOS)
; @in D, E, HASHPOS
; @out A
getFromBlobHashK:
        $ - HASHPOS - D                 :F_MLOAD(blobDataLen),JMPN(invalidParsing)
        E => B
        %INDEX_BLOB_L2_HASH_K_DATA => E
        $ => A                          :HASHK(E)
        B => E                          :RETURN

; @info Add A bytes with D len to HASHP with index E and HASHPOS in C
; @in A, D, E, C
; @out C new HASHPOS
addBatchInputHash:
        HASHPOS                         :MSTORE(blobHashPos)
        C => HASHPOS
        A                               :HASHP(E)
        $ => HASHPOS                    :MLOAD(blobHashPos)
        C + D => C                      :RETURN


;Get zkGasLimit/ZKGAS_PER_BATCH
;@in E zkGasLimit
;@out E zkGasLimit/ZKGAS_PER_BATCH
divZKGAS:
    ; Check if dividend (E) is smaller than divisor E < A
    E => A ; dividend
    %ZKGAS_PER_BATCH => B ; divisor
    $                       :LT, JMPC(fin0ZKGAS)

    %ZKGAS_PER_BATCH => A
    ${E%A} => C ; remainder
    ${E/A} => B ; quotient
    0 => D
    E                       :ARITH
    B => E ; result zkGasLimit/ZKGAS_PER_BATCH

    ; check divisor > remainder
    %ZKGAS_PER_BATCH => B ; divisor
    C => A                ; remainder
    $ => A                  :LT
    1                       :ASSERT,RETURN

fin0ZKGAS:
    0 => E
                    :RETURN
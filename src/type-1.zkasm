;;;;;;;;;;;;;;;;;;
;; D.1 - type 1
;;;;;;;;;;;;;;;;;;
startBlobType1:
        ; B === blobDataLen
        0 => HASHPOS
        ; check blobDataLen === BYTES_ETH_BLOB_DATA + bytes kzgCommitment
        B - %BYTES_ETH_BLOB_DATA - %BYTES_KZGCOMMITMENT   :JMPNZ(failAssert)

        %INDEX_HASH_S_COMMITMENT => E
        ${getKzgCommitment()} => A      :MSTORE(kzgCommitmentHash)

        A                               :HASHSDIGEST(E) ; used when type = 1

        $                               :HASHS16(E),MSTORE(kzgCommitment_high)
        $                               :HASHS32(E),MSTORE(kzgCommitment_low)

        1 + %MEM_ALIGN_LEN*31 => C
        $ => B                          :MEM_ALIGN_RD
        %VERSIONED_HASH_VERSION_KZG => A
        31 + %MEM_ALIGN_LEN*1 + %MEM_ALIGN_LEFT_ALIGNMENT => C
        $ => A                          :MEM_ALIGN_RD
        A + B => A
        $ => B                          :MLOAD(versionedHash)
        $                               :EQ,JMPNC(failAssertVersionedHash)

        ${getKzgProof(0)} => A          :MSTORE(kzgProof_high) ; used when type = 1
        ${getKzgProof(1)} => A          :MSTORE(kzgProof_low) ; used when type = 1

        ; HASHPOS start after kzgCommitment --> poseidon(kgzCommitment + blobData)
        48 => HASHPOS
        0 => RR

; check first byte == 0x00 from 32 bytes & copy to polEvalFrBLS12381_pol_eval[i]
addBlobDataMem:
        %INDEX_Z_HASH_P => E
        ; A == first byte, check A == 0x00
        $ => A                          :HASHP1(E),JMPNZ(invalidBlobData)
        ;copy from data to polEvalFrBLS12381_pol_eval
        $                               :HASHP31(E),MSTORE(polEvalFrBLS12381_pol_eval+RR)
        RR + 1 => RR                    :JMP_EQ(%NUM_ARRAY_ETH_BLOB_DATA, callAndAssert, addBlobDataMem)

; if byte0 != 0x00 --> invalidBlobData and update polEvalFrBLS12381_index & add to polEvalFrBLS12381_pol_eval
invalidBlobData:
        ; _index --> 0 Ok, [1-4096] error index
        RR + 1                          :MSTORE(polEvalFrBLS12381_index)
        ; offset = 1 byte + len = 1 byte + left_alignment
        ; store in 31th byte, 0th byte of A
        31 + %MEM_ALIGN_LEN * 1 + %MEM_ALIGN_LEFT_ALIGNMENT => C ; constantes mem_align %MEM_ALIGN_LEFT_ALIGNMENT, %MEM_ALIGN_LEN
        ; A --> invalid byte
        $ => A                          :MEM_ALIGN_RD
        ; A --> invalid byte shift left
        ; read pending 31 bytes and adding whit
        $ + A => A                      :F_HASHP31(E)
        A                               :MSTORE(polEvalFrBLS12381_pol_eval+RR)
        RR + 1 => RR
        RR - %NUM_ARRAY_ETH_BLOB_DATA   :JMPZ(callAndAssert)

addBlobDataMemInvalid:
        $                               :HASHP32(E),MSTORE(polEvalFrBLS12381_pol_eval+RR)
        RR + 1 => RR                    :JMP_NE(%NUM_ARRAY_ETH_BLOB_DATA,addBlobDataMemInvalid)

callAndAssert:
        ; call polEvalFrBLS12381
                                        :CALL(polEvalFrBLS12381) ; ouputs
        $ => A                          :MLOAD(polEvalFrBLS12381_y),CALL(kzgVerify)
        $ => B                          :MLOAD(polEvalFrBLS12381_index),JMPNZ(invalidMSBByte)
        ; A === 1 --> valid, A === 0 --> invalid
        A                               :JMPZ(failAssertKzgVerify)
        ; add batchData to batchHashData = LinearPoseidon(batchData)
        0 => RR
        31 - 1 - 4 => RCX
        ; reading type
        $ => A                          :MLOAD(polEvalFrBLS12381_pol_eval[RR])
        1 + %MEM_ALIGN_LEN * 1 => C
        $                               :MEM_ALIGN_RD,JMPNZ(invalidTypeCompression)

        ; getting totalBodyLen
        2 + %MEM_ALIGN_LEN * 4 => C
        $ => B                          :MEM_ALIGN_RD,MSTORE(totalBodyLen)
        ; BYTES_ETH_BLOB_DATA >= 5 + totalBodyLen
        %BYTES_ETH_BLOB_DATA - 5 - B    :JMPN(invalidParsing)

        ; update batch hash id (E) & nextHashPId
        $ => E                          :MLOAD(nextHashPId)
        E + 1                           :MSTORE(nextHashPId)

        ; A = current 31 bits value
        ; RR = current index array 31 bits value
        ; RCX = remaining bytes on A
        ; D = batch data len
nextBatchBlobData:
readBatchDataLen:
        ; check blobDataProcessed == totalBodyLen > final
        $ => B                          :MLOAD(blobDataProcessed)      
        B - $                           :F_MLOAD(totalBodyLen),JMPZ(finalizeBlob)

        0 => HASHPOS, B
        $ => A                          :MLOAD(polEvalFrBLS12381_pol_eval[RR])
        ; if RCX (remaining bytes on A) === 0 --> readBytesBatchDataLenOnTop
        32 - RCX + %MEM_ALIGN_LEN * 4  => C     :JMP_EQ(32+128*4,readBytesBatchDataLenOnTop)

        ; read 4 bytes, if there are not enought bytes it's filled with zero of m1(B)
        $ => D                          :MEM_ALIGN_RD
        RCX - 4 => RCX                  :JMP_LE(0, readRemainingBatchDataLen,readBatchData)

; all batchlen it's at begining of memory
readBytesBatchDataLenOnTop:
        RR + 1 => RR
        $ => A                          :MLOAD(polEvalFrBLS12381_pol_eval[RR])
        ; offset = 1, len = 4 bytes
        1 + %MEM_ALIGN_LEN * 4 => C
        $ => D                          :MEM_ALIGN_RD
        31 - 4 => RCX                   :JMP(readBatchData)
    
; read rest of bytes of batchDataLen
readRemainingBatchDataLen:
        RR + 1 => RR
        $ => A                          :MLOAD(polEvalFrBLS12381_pol_eval[RR])
        RCX + 31 => RCX                 :JMP_EQ(31, readBatchData)
        1 - %MEM_ALIGN_LEN * RCX + 31 * %MEM_ALIGN_LEN => C
        $ => C                          :MEM_ALIGN_RD
        D + C => D
        
; check if A has pending bytes, this bytes belongs to current BatchData
; three posibilities:
;   batchDataLen (D) === 0
;   pending bytes (RCX) <= batchDataLen (D)  ==> hash this RCX bytes
;   pending bytes (RCX) > batchDataLen (D) ==> hash only D bytes

readBatchData:
        D                               :MSTORE(batchLen),JMP_EQ(0,hashBatchDataEnd)
        4095 * 31 - RR * 31 + RCX - D   :JMPN(invalidParsing)
        
        RCX                             :JMP_EQ(0, loopHash31BytesOfBatchData)
        D - RCX                         :JMPN(allBatchDataInRemainingBytes)

allRemainingBytesBelongsBatchData:
        RCX => D
        32 - RCX + %MEM_ALIGN_LEN * D => C
        $ => C                          :MEM_ALIGN_RD
        C                               :HASHP(E)
        batchLen - RCX => D             :JMP_GE(31, loopHash31BytesOfBatchData, hashLastBytesOfBatchData)
        
allBatchDataInRemainingBytes:
        32 - RCX + %MEM_ALIGN_LEN * D => C
        $ => C                          :MEM_ALIGN_RD
        C                               :HASHP(E)
        RCX - D => RCX                  :JMP(hashBatchDataEnd)

; hash speed up 31 bytes
loopHash31BytesOfBatchData:
        RR + 1 => RR
        ${mem.polEvalFrBLS12381_pol_eval[RR]}     :HASHP31(E),MLOAD(polEvalFrBLS12381_pol_eval[RR])
        D - 31 => D                               :JMP_GE(31, loopHash31BytesOfBatchData)

; hash the last bytes of batch
hashLastBytesOfBatchData:
        31 - D => RCX
        RR + 1 => RR
        1 + %MEM_ALIGN_LEN * D  => C    :JMP_EQ(1, hashBatchDataEnd)
        $ => A                          :MLOAD(polEvalFrBLS12381_pol_eval[RR])
        $ => C                          :MEM_ALIGN_RD
        C                               :HASHP(E)

hashBatchDataEnd:
        $ => B                          :MLOAD(blobDataProcessed)
        $ => C                          :MLOAD(batchLen)
        ; blobDataProcessed = B (blobDataProcessed) + C (batchLen) + 4 bytes of batch length
        C + B + 4                       :MSTORE(blobDataProcessed)
        ; if batchLen === 0 --> readBatchDataLen, else --> nextBatch
        C                               :JMPZ(readBatchDataLen, nextBatch)

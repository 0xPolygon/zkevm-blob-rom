invalidTypeCompression:
    $${eventLog(onError, error_invalid_compression_type)}   :JMP(invalidBlob)
invalidParsing:
    $${eventLog(onError, error_invalid_parsing)}            :JMP(invalidBlob)
invalidTotalBodyLen:
    $${eventLog(onError, error_invalid_totalbody_len)}      :JMP(invalidBlob)
invalidMSBByte:
    $${eventLog(onError, error_invalid_msb_byte)}           :JMP(invalidBlob)
invalidZkGasLimit:
    $${eventLog(onError, error_invalid_zkgaslimit)}         :JMP(invalidBlob)
invalidBlobType:
    $${eventLog(onError, error_invalid_blob_type)}          :JMP(invalidBlob)
invalidForcedBatches:
    $${eventLog(onError, error_invalid_forced_batches)}     :JMP(invalidBlob)
invalidBlobKzgVerify:
    $${eventLog(onError, error_invalid_kzgverify)}          :JMP(invalidBlob)
invalidBlob:
        ; update flag isInvalid
        1                               :MSTORE(isInvalid)
        ; update finalAccBatchHashData = 0
        0                               :MSTORE(finalAccBatchHashData),JMP(finishBlob)

invalidTypeCompression:
    $${eventLog(onError, ROM_BLOB_ERROR_INVALID_COMPRESSION_TYPE)}   :JMP(invalidBlob)
invalidParsing:
    $${eventLog(onError, ROM_BLOB_ERROR_INVALID_PARSING)}            :JMP(invalidBlob)
invalidTotalBodyLen:
    $${eventLog(onError, ROM_BLOB_ERROR_INVALID_TOTALBODY_LEN)}      :JMP(invalidBlob)
invalidMSBByte:
    $${eventLog(onError, ROM_BLOB_ERROR_INVALID_MSB_BYTE)}           :JMP(invalidBlob)
invalidZkGasLimit:
    $${eventLog(onError, ROM_BLOB_ERROR_INVALID_ZK_GAS_LIMIT)}       :JMP(invalidBlob)
invalidBlobType:
    $${eventLog(onError, ROM_BLOB_ERROR_INVALID_BLOB_TYPE)}          :JMP(invalidBlob)
invalidForcedBatches:
    $${eventLog(onError, ROM_BLOB_ERROR_INVALID_FORCED_BATCHES)}     :JMP(invalidBlob)
invalidBlob:
        ; update flag isInvalid
        1                               :MSTORE(isInvalid)
        ; update finalAccBatchHashData = 0
        0                               :MSTORE(finalAccBatchHashData),JMP(finishBlob)

failAssertForkId:
    $${eventLog(onError, invalid_forkid)}                   :JMP(failAssert)
failAssertVersionedHash:
    $${eventLog(onError, invalid_versioned_hash)}           :JMP(failAssert)
failAssertKzgVerify:
    $${eventLog(onError, invalid_kzgVerify)}                :JMP(failAssert)

;@info function to force a failed assert
failAssert:
    1 => A
    2               :ASSERT